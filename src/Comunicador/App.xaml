<Application x:Class="Comunicador.App"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="clr-namespace:Comunicador.ViewModels"
              xmlns:views="clr-namespace:Comunicador.Views"
              xmlns:conv="clr-namespace:Comunicador.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusComputadorToBrushConverter x:Key="StatusComputadorToBrushConverter" />
            <conv:StatusComputadorToTextoConverter x:Key="StatusComputadorToTextoConverter" />
            <conv:DirecaoHistoricoToTextoConverter x:Key="DirecaoHistoricoToTextoConverter" />
            <conv:PareadoToTextoConverter x:Key="PareadoToTextoConverter" />
            <conv:StatusEnvioToTextoConverter x:Key="StatusEnvioToTextoConverter" />
            <conv:StatusEnvioToBrushConverter x:Key="StatusEnvioToBrushConverter" />
            <conv:ContagemParaVisibilidadeConverter x:Key="ContagemParaVisibilidadeConverter" />
            <conv:TextoParaVisibilidadeConverter x:Key="TextoParaVisibilidadeConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:ComputadoresViewModel}">
                <views:ComputadoresView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MensagensViewModel}">
                <views:MensagensView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LembretesViewModel}">
                <views:LembretesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoricoViewModel}">
                <views:HistoricoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfiguracoesViewModel}">
                <views:ConfiguracoesView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
