<Window x:Class="Comunicador.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="250" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" WindowStartupLocation="CenterScreen"
        Title="Comunicador">
    <Border Margin="10" Padding="22,16" CornerRadius="18"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="PulseIcon" Width="96" Height="96" Grid.Row="0"
                   Source="/Assets/Comunicador-Splash.png"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <TextBlock Grid.Row="1" Text="Iniciando o Comunicador"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,1,0,3" />
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Preparando..."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,10" />
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="StartupProgress" Height="5" Minimum="0" Maximum="100"
                             Value="0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource BorderBrush}" BorderThickness="0" />
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
