<Window x:Class="Comunicador.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190" Height="190" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" WindowStartupLocation="CenterScreen"
        Title="Comunicador">
    <Grid>
        <Image x:Name="PulseIcon" Width="160" Height="160"
               Source="/Assets/Comunicador-Splash.png"
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
