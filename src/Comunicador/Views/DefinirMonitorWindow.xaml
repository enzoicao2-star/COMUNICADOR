<Window x:Class="Comunicador.Views.DefinirMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        Title="Definir monitor" Width="900" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Border Background="{DynamicResource BackgroundBrush}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Definir monitor" FontSize="23" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SubtituloMonitor" Style="{StaticResource Subtitulo}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6"
                        CornerRadius="11" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Sempre no topo" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.9*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Padding="16" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Prévia do monitor" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Arraste a imagem ou ajuste X e Y ao lado."
                                       Style="{StaticResource Subtitulo}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="8" CornerRadius="12" Background="#10151E"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <Canvas x:Name="MonitorCanvas" Background="#080B11"
                                    ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown"
                                    MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
                                <controls:AnimatedImage x:Name="ImagemPreview" Stretch="Uniform"
                                    Cursor="SizeAll" MouseLeftButtonDown="Preview_MouseDown"
                                    MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp" />
                            </Canvas>
                        </Border>
                        <TextBlock Grid.Row="2" Text="A imagem permanece dentro dos limites do monitor."
                                   Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,11,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Posição e tamanho" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Os valores acompanham a resolução deste monitor."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,3,0,15" />

                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Posição horizontal" Style="{StaticResource RotuloCampo}" />
                            <TextBlock x:Name="TextoX" Grid.Column="1" Text="50%" TextAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider x:Name="SliderX" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                    Value="50" ValueChanged="Opcao_Changed" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Posição vertical" Style="{StaticResource RotuloCampo}" />
                            <TextBlock x:Name="TextoY" Grid.Column="1" Text="50%" TextAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider x:Name="SliderY" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                    Value="50" ValueChanged="Opcao_Changed" />
                        </Grid>
                        <Grid Margin="0,0,0,17">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Largura no monitor" Style="{StaticResource RotuloCampo}" />
                            <TextBlock x:Name="TextoTamanho" Grid.Column="1" Text="70%" TextAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider x:Name="SliderTamanho" Grid.Row="1" Grid.ColumnSpan="2" Minimum="10" Maximum="100"
                                    Value="70" ValueChanged="Opcao_Changed" />
                        </Grid>

                        <Border Padding="12" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ManterAteRemover" Content="Manter na tela até eu remover"
                                          Foreground="{DynamicResource TextPrimaryBrush}" Checked="Permanencia_Changed"
                                          Unchecked="Permanencia_Changed" />
                                <TextBlock Text="Sem contagem regressiva. Você pode fechar clicando na imagem ou pressionando Esc."
                                           Style="{StaticResource Subtitulo}" FontSize="11" TextWrapping="Wrap"
                                           Margin="24,3,0,10" />
                                <CheckBox x:Name="RestaurarAposReiniciar" Content="Restaurar após reiniciar o computador"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="A imagem será salva no Receptor e reaparecerá quando ele iniciar."
                                           Style="{StaticResource Subtitulo}" FontSize="11" TextWrapping="Wrap"
                                           Margin="24,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusImagem" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"
                           Text="O GIF é reproduzido nesta prévia enquanto você ajusta a posição." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Click="Cancelar_Click"
                            Margin="0,0,8,0" />
                    <Button Content="Definir monitor" Style="{StaticResource BotaoPrimario}" Click="Definir_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
