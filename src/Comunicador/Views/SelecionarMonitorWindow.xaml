<UserControl x:Class="Comunicador.Views.SelecionarMonitorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Definir monitor" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Escolha um monitor e configure a mídia em uma única prévia."
                           Style="{StaticResource Subtitulo}" Margin="0,4,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="‹ Voltar ao envio"
                    Style="{StaticResource BotaoSecundario}" Click="Voltar_Click" />
        </Grid>

        <Border Grid.Row="1" Padding="14" Margin="0,0,0,12" CornerRadius="12"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Computador e monitor" Style="{StaticResource RotuloCampo}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="MonitorSelecionado" Grid.Column="1" MinHeight="44"
                          ItemsSource="{Binding MonitoresDestino}" SelectedIndex="0"
                          SelectionChanged="Monitor_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Resolucao}" DockPanel.Dock="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,0,0,0" />
                                <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="StatusSelecao" Grid.Column="2" VerticalAlignment="Center"
                           Style="{StaticResource Subtitulo}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <ContentControl x:Name="EditorMonitorHost" Grid.Row="2" />
    </Grid>
</UserControl>
