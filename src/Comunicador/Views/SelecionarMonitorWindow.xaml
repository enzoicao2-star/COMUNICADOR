<Window x:Class="Comunicador.Views.SelecionarMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        Title="Definir monitores" Width="1040" Height="760" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Escolher monitores" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Cada quadro mostra o papel de parede atual. Solte uma imagem, GIF ou vídeo no monitor desejado."
                           Style="{StaticResource Subtitulo}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Atualizar miniaturas"
                    Style="{StaticResource BotaoSecundario}" Click="Atualizar_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MonitoresDestino}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ResponsiveColumnsPanel MinColumnWidth="340" MaxColumns="3"
                                                         ColumnGap="14" RowGap="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" CornerRadius="14"
                                Background="{DynamicResource CardSurfaceBrush}"
                                BorderBrush="{DynamicResource CardGlassBorderBrush}" BorderThickness="1"
                                AllowDrop="True" PreviewDragOver="Monitor_DragOver"
                                PreviewDragEnter="Monitor_DragEnter" PreviewDragLeave="Monitor_DragLeave"
                                Drop="Monitor_Drop">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Titulo}" />
                                        <TextBlock Text="{Binding Resolucao}" Style="{StaticResource Subtitulo}"
                                                   FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Width="300" Height="{Binding AlturaPreview}" HorizontalAlignment="Center"
                                        CornerRadius="8" ClipToBounds="True" Background="#080B11"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding WallpaperPreview}" Stretch="Fill" Opacity="0.88" />
                                        <TextBlock Text="Papel de parede indisponível" Foreground="#B8C4D6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WallpaperPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="#88080B11" Margin="8" CornerRadius="5"
                                                IsHitTestVisible="False">
                                            <ItemsControl ItemsSource="{Binding Midias}" VerticalAlignment="Center"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="3">
                                                            <controls:AnimatedImage DataBase64="{Binding PreviewDataBase64}"
                                                                MimeType="{Binding MimeType}" Width="{Binding PreviewWidth}"
                                                                MaxWidth="270" MaxHeight="130" Stretch="Uniform">
                                                                <controls:AnimatedImage.Style>
                                                                    <Style TargetType="controls:AnimatedImage">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EhVideo}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AnimatedImage.Style>
                                                            </controls:AnimatedImage>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EhVideo}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="27" Foreground="White" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Vídeo" Foreground="White" FontSize="11"
                                                                           HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Text="Solte a mídia aqui" Foreground="White" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Midias.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding WallpaperPreviewState}" Style="{StaticResource Subtitulo}"
                                           FontSize="10" Margin="0,7,0,3" />
                                <ItemsControl ItemsSource="{Binding Midias}" Margin="0,5,0,3">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="×" Padding="7,1"
                                                        Style="{StaticResource BotaoSecundario}"
                                                        Command="{Binding DataContext.RemoverImagemMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Content="Definir monitor" Style="{StaticResource BotaoPrimario}"
                                            Margin="0,0,7,5" Click="DefinirMonitor_Click"
                                            ToolTip="Arraste e redimensione a imagem neste monitor" />
                                    <Button Content="Usar mídia carregada" Style="{StaticResource BotaoSecundario}"
                                            Margin="0,0,7,5"
                                            Command="{Binding DataContext.UsarImagemCarregadaNoMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Outra imagem" Style="{StaticResource BotaoSecundario}"
                                            Margin="0,0,7,5" Click="OutraImagem_Click" />
                                    <Button Content="Outro vídeo" Style="{StaticResource BotaoSecundario}"
                                            Margin="0,0,0,5" Click="OutroVideo_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="As miniaturas são guardadas por computador e atualizadas quando o papel de parede muda e a cada 5 horas."
                       Style="{StaticResource Subtitulo}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    Margin="14,0,0,0" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
