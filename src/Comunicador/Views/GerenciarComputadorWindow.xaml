<UserControl x:Class="Comunicador.Views.GerenciarComputadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Gerenciar computador" Style="{StaticResource TituloSecao}" />
            <TextBlock Text="Configurações, permissões e ações para este computador." Style="{StaticResource Subtitulo}" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Identificação e estado" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="{Binding ComputadorGerenciado.NomeExibicao, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Style="{StaticResource Subtitulo}">
                            <Run Text="{Binding ComputadorGerenciado.Nome, Mode=OneWay}" /><Run Text="  ·  " />
                            <Run Text="{Binding ComputadorGerenciado.EnderecoIp, Mode=OneWay}" /><Run Text="  ·  " />
                            <Run Text="{Binding ComputadorGerenciado.Status, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Subtitulo}" Margin="0,5,0,0">
                            <Run Text="{Binding ComputadorGerenciado.StatusVersaoPainel, Mode=OneWay}" /><Run Text="  ·  " />
                            <Run Text="{Binding ComputadorGerenciado.StatusVersaoReceptor, Mode=OneWay}" /><Run Text="  ·  " />
                            <Run Text="{Binding ComputadorGerenciado.QuantidadeMonitores, Mode=OneWay}" /><Run Text=" monitor(es)" />
                        </TextBlock>
                        <TextBlock Text="{Binding ComputadorGerenciado.StatusRecebimentoMidias}" Margin="0,5,0,0"
                                   Foreground="#A15C00" Visibility="{Binding ComputadorGerenciado.MidiasBloqueadas, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Testar comunicação" Style="{StaticResource BotaoSecundario}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding TestarComunicacaoCommand}"
                                CommandParameter="{Binding ComputadorGerenciado}" />
                        <TextBlock Text="{Binding TesteComunicacaoStatus}" Style="{StaticResource Subtitulo}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Nome público" Style="{StaticResource TituloCard}" />
                        <TextBox Margin="0,9,0,0" MaxLength="60"
                                 IsEnabled="{Binding ComputadorGerenciado.PodeEditarNome}"
                                 Text="{Binding ComputadorGerenciado.Apelido, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Badges e permissões" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="As permissões administrativas continuam controladas pelo OWNER." Style="{StaticResource Subtitulo}" Margin="0,4,0,10" />
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                Visibility="{Binding ComputadorGerenciado.PodeGerenciarAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Permissões individuais" Style="{StaticResource RotuloCampo}" />
                                <TextBlock Text="Estas permissões valem somente para este usuário e são sincronizadas entre os painéis."
                                           Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <WrapPanel>
                                    <CheckBox Content="Gerenciar perfis" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualGerenciarPerfil}" Margin="0,0,14,7" />
                                    <CheckBox Content="Gerenciar badges" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualGerenciarBadges}" Margin="0,0,14,7" />
                                    <CheckBox Content="Enviar mídias" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualEnviarMidias}" Margin="0,0,14,7" />
                                    <CheckBox Content="Alterar papel de parede" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualAlterarPapelParede}" Margin="0,0,14,7" />
                                    <CheckBox Content="Instalar painel" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualInstalarPainel}" Margin="0,0,14,7" />
                                    <CheckBox Content="Bloquear / liberar painel" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualControlarAcesso}" Margin="0,0,14,7" />
                                    <CheckBox Content="Atualizar receptor" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualAtualizarReceptor}" Margin="0,0,14,7" />
                                    <CheckBox Content="CMD remoto" IsChecked="{Binding ComputadorGerenciado.PermissaoIndividualCmdRemoto}" Margin="0,0,14,7" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ComputadorGerenciado.Badges}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Margin="0,0,8,6" Padding="0" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.EditarBadgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <controls:InteractiveBadge Text="{Binding Texto}" Color="{Binding Cor}" Icon="{Binding Icone}"
                                        BadgeStyle="{Binding Estilo}" CustomIconBase64="{Binding IconePersonalizadoBase64}"
                                        Glow="{Binding Brilho}" Interactive="{Binding EfeitoMouse}" FloatAnimation="{Binding AnimacaoFlutuante}" />
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBox Width="140" Margin="0,0,8,7" Text="{Binding ComputadorGerenciado.NovoBadgeTexto, UpdateSourceTrigger=PropertyChanged}" />
                            <controls:ColorPickerPopover Width="126" Margin="0,0,8,7"
                                SelectedColor="{Binding ComputadorGerenciado.NovoBadgeCor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="125" Margin="0,0,8,7" ItemsSource="{Binding EstilosBadge}" SelectedItem="{Binding ComputadorGerenciado.NovoBadgeEstilo}" />
                            <ComboBox Width="125" Margin="0,0,8,7" ItemsSource="{Binding IconesBadge}" SelectedItem="{Binding ComputadorGerenciado.NovoBadgeIcone}" />
                            <Button Content="Ícone próprio" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,7"
                                    Command="{Binding CarregarIconeBadgeCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="Brilho" IsChecked="{Binding ComputadorGerenciado.NovoBadgeBrilho}" Margin="0,0,14,7" />
                            <CheckBox Content="Efeito ao passar o mouse" IsChecked="{Binding ComputadorGerenciado.NovoBadgeEfeitoMouse}" Margin="0,0,14,7" />
                            <CheckBox Content="Flutuação suave" IsChecked="{Binding ComputadorGerenciado.NovoBadgeAnimacaoFlutuante}" Margin="0,0,14,7" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Adicionar / aplicar badge" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                    Command="{Binding AdicionarBadgeCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Nova badge" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding NovaBadgeCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                        </WrapPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                                Visibility="{Binding ComputadorGerenciado.PodeGerenciarAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Tags administrativas deste computador" Style="{StaticResource RotuloCampo}" />
                                <TextBlock Text="Selecione uma tag criada na Administração global. Suas permissões acompanham a tag em todos os painéis."
                                           Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <ComboBox ItemsSource="{Binding ModelosBadgeGlobal}" DisplayMemberPath="Nome" SelectedValuePath="Id"
                                          SelectedValue="{Binding ComputadorGerenciado.NovoBadgeRoleId}" Width="230" HorizontalAlignment="Left" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Atribuir tag" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                            Command="{Binding AtribuirTagAdminCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                                    <Button Content="Retirar tag" Style="{StaticResource BotaoSecundario}"
                                            Command="{Binding RemoverTagAdminCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="Admin delegado legado (gerenciar perfis)" Style="{StaticResource BotaoSecundario}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Visibility="{Binding ComputadorGerenciado.PodeGerenciarAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding AlternarAdminDelegadoCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12"
                        Visibility="{Binding ComputadorGerenciado.PodeAdministrarRemotamente, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Ações remotas do OWNER" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Este computador está salvo nesta lista, mas não está registrado na nuvem. Abra o Comunicador ou Receptor nele e aguarde a conexão para liberar as ações remotas."
                                   TextWrapping="Wrap" Margin="0,7,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ComputadorGerenciado.RegistradoNaNuvem}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,9,0,0">
                            <Button Content="Restaurar papel de parede anterior" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                    Command="{Binding RestaurarPapelParedeCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Instalar painel" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                    Command="{Binding InstalarPainelRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Reinstalar painel" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                    Command="{Binding ReinstalarPainelRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Atualizar receptor" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                    Command="{Binding AtualizarReceptorCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Bloquear entrada do painel" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                    Command="{Binding BloquearPainelRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Habilitar entrada do painel" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                    Command="{Binding HabilitarPainelRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                        </WrapPanel>
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding ComputadorGerenciado.AtualizandoReceptor, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ComputadorGerenciado.StatusVersaoReceptor, Mode=OneWay}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
                            <ProgressBar Minimum="0" Maximum="100" Height="12"
                                         Value="{Binding ComputadorGerenciado.ProgressoAtualizacaoReceptor, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12"
                        Visibility="{Binding ComputadorGerenciado.PodeUsarCmdRemoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="CMD remoto" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Executa como usuário normal neste computador. A execução pode durar até 5 minutos; cancele antes se quiser interromper. A resposta é limitada a 950 caracteres."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBlock Text="Exemplos: hostname · shutdown /s /t 60 · shutdown /r /t 60 · volume 75 · audio devices · audio select 2"
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBox Text="{Binding ComandoRemoto, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="500" ToolTip="Ex.: hostname, shutdown /s /t 60, shutdown /r /t 60" />
                        <Button Content="Executar no computador" Style="{StaticResource BotaoPrimario}"
                                HorizontalAlignment="Left" Margin="0,10,0,10"
                                Command="{Binding EnviarCmdRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                        <Button Content="Cancelar comando remoto" Style="{StaticResource BotaoSecundario}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                Visibility="{Binding ComandoRemotoEmAndamento, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding CancelarCmdRemotoCommand}" />
                        <TextBox Text="{Binding ResultadoComandoRemoto, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="95" MaxHeight="230"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Lista de computadores" Style="{StaticResource TituloCard}" />
                        <WrapPanel Margin="0,9,0,0">
                            <Button Content="Parear novamente" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                    Command="{Binding PairearCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                            <Button Content="Remover da lista" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding RemoverCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMensagem}" Style="{StaticResource Subtitulo}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Aplicar mudanças e sincronizar" Style="{StaticResource BotaoPrimario}"
                        Command="{Binding SalvarPerfilCommand}" CommandParameter="{Binding ComputadorGerenciado}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
