<UserControl x:Class="Comunicador.Views.TransicoesMidiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comunicador.Controls"
             Focusable="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <TextBlock Text="Transições da mídia" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Escolha como a imagem, o GIF ou o vídeo aparece e sai da tela do computador de destino."
                       Style="{StaticResource Subtitulo}" Margin="0,3,0,18" TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Entrada" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Como a mídia começa a aparecer." Style="{StaticResource Subtitulo}" Margin="0,2,0,10" />
                        <ComboBox SelectedValue="{Binding EfeitoEntrada, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Fade suave" Tag="fade" />
                            <ComboBoxItem Content="Deslizar de cima" Tag="top" />
                            <ComboBoxItem Content="Deslizar de baixo" Tag="bottom" />
                            <ComboBoxItem Content="Deslizar da esquerda" Tag="left" />
                            <ComboBoxItem Content="Deslizar da direita" Tag="right" />
                            <ComboBoxItem Content="Aparecer sem efeito" Tag="none" />
                        </ComboBox>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="Velocidade" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VelocidadeEntradaPercentual, StringFormat={}{0}%}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                        <Slider Minimum="25" Maximum="250" TickFrequency="25" IsSnapToTickEnabled="True"
                                Value="{Binding VelocidadeEntradaPercentual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="100% é a velocidade normal; valores maiores deixam a animação mais rápida."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Saída" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Como a mídia desaparece ao terminar." Style="{StaticResource Subtitulo}" Margin="0,2,0,10" />
                        <ComboBox SelectedValue="{Binding EfeitoSaida, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Fade suave" Tag="fade" />
                            <ComboBoxItem Content="Deslizar para cima" Tag="top" />
                            <ComboBoxItem Content="Deslizar para baixo" Tag="bottom" />
                            <ComboBoxItem Content="Deslizar para a esquerda" Tag="left" />
                            <ComboBoxItem Content="Deslizar para a direita" Tag="right" />
                            <ComboBoxItem Content="Sair sem efeito" Tag="none" />
                        </ComboBox>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="Velocidade" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VelocidadeSaidaPercentual, StringFormat={}{0}%}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                        <Slider Minimum="25" Maximum="250" TickFrequency="25" IsSnapToTickEnabled="True"
                                Value="{Binding VelocidadeSaidaPercentual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="A velocidade de saída é independente da entrada."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Combinações prontas" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" />
            <WrapPanel>
                <Button Style="{StaticResource BotaoSecundario}" Content="Suave" Command="{Binding AplicarPresetTransicaoCommand}"
                        CommandParameter="suave" Margin="0,0,8,8" />
                <Button Style="{StaticResource BotaoSecundario}" Content="Rápida" Command="{Binding AplicarPresetTransicaoCommand}"
                        CommandParameter="rapida" Margin="0,0,8,8" />
                <Button Style="{StaticResource BotaoSecundario}" Content="Destaque · cima para baixo"
                        Command="{Binding AplicarPresetTransicaoCommand}" CommandParameter="destaque" Margin="0,0,8,8" />
                <Button Style="{StaticResource BotaoSecundario}" Content="Sem efeito" Command="{Binding AplicarPresetTransicaoCommand}"
                        CommandParameter="sem-efeito" Margin="0,0,8,8" />
            </WrapPanel>

            <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Prévia das transições" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResumoTransicoes}" Style="{StaticResource Subtitulo}" Margin="0,4,0,6" />
                        <TextBlock Text="Demonstração local: nada será enviado aos computadores."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource BotaoPrimario}" Content="Reproduzir prévia" Click="Reproduzir_Click"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource BotaoSecundario}" Content="Voltar ao envio" Click="Voltar_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <Border x:Name="PreviewArea" Grid.Column="2" Width="300" Height="176" CornerRadius="10"
                            Background="#10131A" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            ClipToBounds="True">
                        <Border x:Name="PreviewMedia" Width="236" Height="132" CornerRadius="8"
                                Background="#262B36" BorderBrush="#8D78FF" BorderThickness="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1">
                            <Grid>
                                <controls:AnimatedImage DataBase64="{Binding ImagemPreviewBase64}" MimeType="{Binding MimeImagem}"
                                                        Stretch="Uniform" Margin="6"
                                                        Visibility="{Binding TemImagem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemImagem}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#B5A9FF"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="PRÉVIA DA MÍDIA" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
