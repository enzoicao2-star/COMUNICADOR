<UserControl x:Class="Comunicador.Views.TransicoesMidiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comunicador.Controls"
             Focusable="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Voltar ao envio"
                        Click="Voltar_Click" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Transições ligadas" IsChecked="{Binding TransicoesAtivas}"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel>
                    <TextBlock Text="Transições da mídia" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Configure separadamente como a mídia aparece e desaparece."
                               Style="{StaticResource Subtitulo}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Entrada" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NomeEfeitoEntrada}" Style="{StaticResource Subtitulo}" Margin="0,3,0,12" />
                        <controls:TransicaoEfeitoPreview Height="150" EffectId="{Binding EfeitoEntrada}"
                            PreviewImage="{Binding ImagemPreviewTransicoes}" PreviewLabel="{Binding TextoPreviewTransicoes}"
                            IsExitPreview="False" TimeMode="{Binding ModoTempoEntrada}"
                            SpeedPercent="{Binding VelocidadeEntradaPercentual}" DurationMs="{Binding DuracaoEntradaMs}" />
                        <Button Style="{StaticResource BotaoPrimario}" Content="Selecionar transição de entrada"
                                Click="SelecionarEntrada_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                        <ComboBox SelectedValue="{Binding ModoTempoEntrada, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag" Margin="0,10,0,0">
                            <ComboBoxItem Content="Ajustar velocidade" Tag="speed" />
                            <ComboBoxItem Content="Definir duração exata" Tag="duration" />
                        </ComboBox>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Velocidade (100% = normal)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Width="72" HorizontalContentAlignment="Right"
                                     Text="{Binding VelocidadeEntradaPercentual, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <Slider Minimum="25" Maximum="250" TickFrequency="1" IsSnapToTickEnabled="False"
                                Value="{Binding VelocidadeEntradaPercentual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <Slider.Style>
                                <Style TargetType="Slider">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoTempoEntrada}" Value="duration">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoTempoEntrada}" Value="duration">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Duração exata" VerticalAlignment="Center" />
                            <TextBox Width="82" Margin="10,0,6,0" HorizontalContentAlignment="Right"
                                     Text="{Binding DuracaoEntradaMs, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="ms" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Saída" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NomeEfeitoSaida}" Style="{StaticResource Subtitulo}" Margin="0,3,0,12" />
                        <controls:TransicaoEfeitoPreview Height="150" EffectId="{Binding EfeitoSaida}"
                            PreviewImage="{Binding ImagemPreviewTransicoes}" PreviewLabel="{Binding TextoPreviewTransicoes}"
                            IsExitPreview="True" TimeMode="{Binding ModoTempoSaida}"
                            SpeedPercent="{Binding VelocidadeSaidaPercentual}" DurationMs="{Binding DuracaoSaidaMs}" />
                        <Button Style="{StaticResource BotaoPrimario}" Content="Selecionar transição de saída"
                                Click="SelecionarSaida_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                        <ComboBox SelectedValue="{Binding ModoTempoSaida, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag" Margin="0,10,0,0">
                            <ComboBoxItem Content="Ajustar velocidade" Tag="speed" />
                            <ComboBoxItem Content="Definir duração exata" Tag="duration" />
                        </ComboBox>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Velocidade (100% = normal)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Width="72" HorizontalContentAlignment="Right"
                                     Text="{Binding VelocidadeSaidaPercentual, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <Slider Minimum="25" Maximum="250" TickFrequency="1" IsSnapToTickEnabled="False"
                                Value="{Binding VelocidadeSaidaPercentual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <Slider.Style>
                                <Style TargetType="Slider">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoTempoSaida}" Value="duration">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoTempoSaida}" Value="duration">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Duração exata" VerticalAlignment="Center" />
                            <TextBox Width="82" Margin="10,0,6,0" HorizontalContentAlignment="Right"
                                     Text="{Binding DuracaoSaidaMs, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="ms" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Combinações prontas" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Style="{StaticResource BotaoSecundario}" Content="Suave" Command="{Binding AplicarPresetTransicaoCommand}"
                                CommandParameter="suave" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BotaoSecundario}" Content="Rápida" Command="{Binding AplicarPresetTransicaoCommand}"
                                CommandParameter="rapida" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BotaoSecundario}" Content="Destaque · cima para baixo"
                                Command="{Binding AplicarPresetTransicaoCommand}" CommandParameter="destaque" Margin="0,0,8,8" />
                        <Button Style="{StaticResource BotaoSecundario}" Content="Sem efeito"
                                Command="{Binding AplicarPresetTransicaoCommand}" CommandParameter="sem-efeito" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
