<UserControl x:Class="Comunicador.Views.AlterarSenhaAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
      <Border Style="{StaticResource CardBorder}" Padding="24" Margin="12" Width="500"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Alterar senha do OWNER" Style="{StaticResource TituloCard}" FontSize="20" />
            <TextBlock Text="A nova senha também servirá para recuperar o acesso em outro computador."
                       Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,5,0,16" />
            <TextBlock Text="Senha atual" Style="{StaticResource RotuloCampo}" />
            <PasswordBox x:Name="AtualBox" MinHeight="38" MaxLength="256" />
            <TextBlock Text="Nova senha" Style="{StaticResource RotuloCampo}" Margin="0,12,0,0" />
            <PasswordBox x:Name="NovaBox" MinHeight="38" MaxLength="256" />
            <TextBlock Text="Confirmar nova senha" Style="{StaticResource RotuloCampo}" Margin="0,12,0,0" />
            <PasswordBox x:Name="ConfirmacaoBox" MinHeight="38" MaxLength="256" />
            <TextBlock x:Name="Erro" Foreground="#D24747" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Voltar" Style="{StaticResource BotaoSecundario}" Click="Cancelar_OnClick" />
                <Button Grid.Column="3" Content="Alterar senha" Style="{StaticResource BotaoPrimario}" Click="Confirmar_OnClick" IsDefault="True" />
            </Grid>
        </StackPanel>
      </Border>
    </Grid>
</UserControl>
