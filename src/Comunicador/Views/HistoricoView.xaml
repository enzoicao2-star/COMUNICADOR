<UserControl x:Class="Comunicador.Views.HistoricoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Histórico" Style="{StaticResource TituloSecao}" />
            <TextBlock Text="Tudo que foi enviado e recebido, com as respostas." Style="{StaticResource Subtitulo}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,11,0" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="12,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Filtrar por computador, título ou mensagem" Margin="34,0,0,0"
                           VerticalAlignment="Center" Foreground="#9D9D9D" FontSize="13" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filtro}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Command="{Binding LimparCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="Limpar" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,48,0,0" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Itens.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                       Foreground="{StaticResource UnknownBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Nada por aqui ainda" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource Subtitulo}" HorizontalAlignment="Center"
                       Text="As mensagens enviadas e recebidas aparecem nesta lista." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ItensFiltrados}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardListaBorder}" Margin="0,0,0,8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,2,14,0"
                                           VerticalAlignment="Top"
                                           Text="{Binding Direcao, Converter={StaticResource DirecaoParaIconeConverter}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Subtitulo}" Margin="0,2,0,0">
                                        <Run Text="{Binding Direcao, Converter={StaticResource DirecaoHistoricoToTextoConverter}, Mode=OneWay}" />
                                        <Run Text="{Binding ComputadorNome, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  ·  " Foreground="#B0B0B0" />
                                        <Run Text="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13" />
                                    <Border Margin="0,10,0,0" CornerRadius="4" Padding="10,8" Background="#F0F6FF"
                                            BorderBrush="#CCE4F7" BorderThickness="1"
                                            Visibility="{Binding RespostaTexto, Converter={StaticResource TextoParaVisibilidadeConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding RespostaTexto}" TextWrapping="Wrap" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource SeloBorder}" Margin="12,0,0,0"
                                        Background="{Binding Status, Converter={StaticResource StatusEnvioToBrushConverter}}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusEnvioToTextoConverter}}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
