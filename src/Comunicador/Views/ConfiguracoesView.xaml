<UserControl x:Class="Comunicador.Views.ConfiguracoesView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comunicador.Controls"
             Loaded="OnViewLoaded" Unloaded="OnViewUnloaded">
    <UserControl.Resources>
        <Style x:Key="ConfigTabButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="TabScale" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16" /><DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" /><DoubleAnimation Storyboard.TargetName="TabScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Card" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="CardScale" /></Border.RenderTransform>
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="SelectedMark" Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,7,7,0" Visibility="Collapsed">
                                <Path Data="M 0,4 L 3,7 L 8,0" Stroke="White" StrokeThickness="1.7"
                                      Width="10" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.18" /><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" /><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SelectedMark" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.20" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.975" Duration="0:0:0.08" />
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.975" Duration="0:0:0.08" />
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.018" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.018" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Configurações" Style="{StaticResource TituloSecao}" />
                <TextBlock Text="Preferências locais deste painel, salvas automaticamente." Style="{StaticResource Subtitulo}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,0,0" />
        </Grid>

        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="11" Padding="5" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ConfigTabButton}" Content="Personalização"
                        Command="{Binding NavegarConfiguracaoCommand}" CommandParameter="personalizacao"
                        Tag="{Binding SecaoConfiguracoes, ConverterParameter=personalizacao, Converter={StaticResource SecaoAtivaConverter}}" />
                <Button Style="{StaticResource ConfigTabButton}" Content="Recebimento"
                        Command="{Binding NavegarConfiguracaoCommand}" CommandParameter="recebimento"
                        Tag="{Binding SecaoConfiguracoes, ConverterParameter=recebimento, Converter={StaticResource SecaoAtivaConverter}}" />
                <Button Style="{StaticResource ConfigTabButton}" Content="Painel e rede"
                        Command="{Binding NavegarConfiguracaoCommand}" CommandParameter="geral"
                        Tag="{Binding SecaoConfiguracoes, ConverterParameter=geral, Converter={StaticResource SecaoAtivaConverter}}" />
            </StackPanel>
        </Border>

        <Grid>
            <!-- PERSONALIZAÇÃO -->
            <ScrollViewer x:Name="PersonalizacaoPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SecaoConfiguracoes}" Value="personalizacao">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <controls:ResponsiveColumnsPanel MinColumnWidth="360" MaxColumns="2"
                                                 ColumnGap="16" RowGap="16" Margin="0,0,8,12">
                    <Border Style="{StaticResource CardBorder}" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tema e cor" Style="{StaticResource TituloCard}" />
                            <TextBlock Text="Clique em uma prévia para aplicar. A cor escolhida aparece nas duas opções."
                                       Style="{StaticResource Subtitulo}" Margin="0,2,0,12" />
                            <Grid Margin="-4,0,-4,14">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Height="112" Style="{StaticResource ChoiceCardButton}"
                                        Command="{Binding SelecionarTemaCommand}" CommandParameter="Claro"
                                        Tag="{Binding Tema, ConverterParameter=Claro, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="#F0F4F9" Margin="0">
                                        <Border Height="23" Background="#FFFFFF" VerticalAlignment="Top" />
                                        <StackPanel Margin="13,33,13,9">
                                            <Border Height="9" Width="74" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Left" />
                                            <Border Height="25" Margin="0,8,0,0" CornerRadius="5" Background="#FFFFFF"
                                                    BorderBrush="#CBD5E1" BorderThickness="1" />
                                            <TextBlock Text="Claro" Foreground="#111923" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Margin="0,6,3,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1" Height="112" Style="{StaticResource ChoiceCardButton}"
                                        Command="{Binding SelecionarTemaCommand}" CommandParameter="Escuro"
                                        Tag="{Binding Tema, ConverterParameter=Escuro, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="#080B11">
                                        <Border Height="23" Background="#121923" VerticalAlignment="Top" />
                                        <StackPanel Margin="13,33,13,9">
                                            <Border Height="9" Width="74" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Left" />
                                            <Border Height="25" Margin="0,8,0,0" CornerRadius="5" Background="#192231"
                                                    BorderBrush="#52637C" BorderThickness="1" />
                                            <TextBlock Text="Escuro" Foreground="#F7F9FC" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Margin="0,6,3,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <TextBlock Text="Paletas do Comunicador" Style="{StaticResource RotuloCampo}" />
                            <UniformGrid Columns="2" Margin="-4,0,-4,0">
                                <Button Height="48" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarPaletaCommand}"
                                        CommandParameter="Azul" Tag="{Binding Paleta, ConverterParameter=Azul, Converter={StaticResource SecaoAtivaConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="13,0"><Ellipse Width="18" Height="18" Fill="#4C8DFF" /><TextBlock Text="Azul" Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Height="48" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarPaletaCommand}"
                                        CommandParameter="Violeta" Tag="{Binding Paleta, ConverterParameter=Violeta, Converter={StaticResource SecaoAtivaConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="13,0"><Ellipse Width="18" Height="18" Fill="#8B7CFF" /><TextBlock Text="Violeta" Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Height="48" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarPaletaCommand}"
                                        CommandParameter="Verde" Tag="{Binding Paleta, ConverterParameter=Verde, Converter={StaticResource SecaoAtivaConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="13,0"><Ellipse Width="18" Height="18" Fill="#27B07D" /><TextBlock Text="Verde" Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Height="48" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarPaletaCommand}"
                                        CommandParameter="Coral" Tag="{Binding Paleta, ConverterParameter=Coral, Converter={StaticResource SecaoAtivaConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="13,0"><Ellipse Width="18" Height="18" Fill="#F06E5B" /><TextBlock Text="Coral" Margin="9,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                            </UniformGrid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,14,4,13" />
                            <TextBlock Text="Minhas predefinições" Style="{StaticResource RotuloCampo}" />
                            <TextBlock Text="Crie uma cor própria em hexadecimal. Ela fica salva somente neste painel."
                                       Style="{StaticResource Subtitulo}" FontSize="12" Margin="0,-2,0,9" />
                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Nome" Style="{StaticResource RotuloCampo}" />
                                    <TextBox Text="{Binding NomeNovaPaleta, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cor" Style="{StaticResource RotuloCampo}" />
                                    <Grid>
                                        <TextBox Text="{Binding CorNovaPaleta, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="20" Padding="34,0,8,0" />
                                        <Ellipse Width="16" Height="16" HorizontalAlignment="Left" Margin="10,0,0,0"
                                                 Fill="{Binding CorNovaPaletaVisual}" IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Button Content="Salvar como predefinição" Style="{StaticResource BotaoPrimario}"
                                    HorizontalAlignment="Left" Margin="4,0,4,8"
                                    Command="{Binding SalvarPaletaPersonalizadaCommand}" />
                            <ItemsControl ItemsSource="{Binding PaletasPersonalizadas}" Margin="0,1,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0">
                                            <Button Height="48" Margin="4" Padding="13,0,38,0"
                                                    Style="{StaticResource ChoiceCardButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.SelecionarPaletaCommand}"
                                                    CommandParameter="{Binding Id}" Tag="{Binding EstadoSelecao}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="18" Height="18" Fill="{Binding Cor}" />
                                                    <TextBlock Text="{Binding Nome}" Margin="9,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button Width="27" Height="27" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,11,0" Style="{StaticResource BotaoSecundario}"
                                                    Padding="0" Content="×" FontSize="16"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.RemoverPaletaPersonalizadaCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Fundo do painel" Style="{StaticResource TituloCard}" />
                            <TextBlock Text="As prévias ficam paradas; ao selecionar, todos os fundos ganham movimento no painel."
                                       Style="{StaticResource Subtitulo}" Margin="0,2,0,10" />
                            <UniformGrid Columns="2" Margin="-4,0,-4,8">
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Sem fundo" Tag="{Binding FundoPainel, ConverterParameter=Sem fundo, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><TextBlock Text="Sem fundo" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                                </Button>
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Topográfico" Tag="{Binding FundoPainel, ConverterParameter=Topográfico, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><controls:AnimatedBackground Mode="Topográfico" Intensity="100" ReduceMotion="True" /><Border Background="#66000000" VerticalAlignment="Bottom" Height="28" /><TextBlock Text="Topográfico" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /></Grid>
                                </Button>
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Caminhos flutuantes" Tag="{Binding FundoPainel, ConverterParameter=Caminhos flutuantes, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><controls:AnimatedBackground Mode="Caminhos flutuantes" Intensity="100" ReduceMotion="True" /><Border Background="#66000000" VerticalAlignment="Bottom" Height="28" /><TextBlock Text="Caminhos" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /></Grid>
                                </Button>
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Vórtice" Tag="{Binding FundoPainel, ConverterParameter=Vórtice, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><controls:AnimatedBackground Mode="Vórtice" Intensity="100" ReduceMotion="True" /><Border Background="#66000000" VerticalAlignment="Bottom" Height="28" /><TextBlock Text="Vórtice" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /></Grid>
                                </Button>
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Ondas luminosas" Tag="{Binding FundoPainel, ConverterParameter=Ondas luminosas, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><controls:AnimatedBackground Mode="Ondas luminosas" Intensity="100" ReduceMotion="True" /><Border Background="#66000000" VerticalAlignment="Bottom" Height="28" /><TextBlock Text="Ondas" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /></Grid>
                                </Button>
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Constelação" Tag="{Binding FundoPainel, ConverterParameter=Constelação, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><controls:AnimatedBackground Mode="Constelação" Intensity="100" ReduceMotion="True" /><Border Background="#66000000" VerticalAlignment="Bottom" Height="28" /><TextBlock Text="Constelação" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /></Grid>
                                </Button>
                                <Button Height="94" Style="{StaticResource ChoiceCardButton}" Command="{Binding SelecionarFundoCommand}"
                                        CommandParameter="Grade fluida" Tag="{Binding FundoPainel, ConverterParameter=Grade fluida, Converter={StaticResource SecaoAtivaConverter}}">
                                    <Grid Background="{DynamicResource BackgroundBrush}"><controls:AnimatedBackground Mode="Grade fluida" Intensity="100" ReduceMotion="True" /><Border Background="#66000000" VerticalAlignment="Bottom" Height="28" /><TextBlock Text="Grade fluida" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /></Grid>
                                </Button>
                            </UniformGrid>
                            <Border Margin="4,6,4,3" Padding="11,8" CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Fundos sempre exibidos em intensidade máxima" FontSize="12" Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>
                            <CheckBox IsChecked="{Binding ReduzirMovimento}" Margin="0,3,0,0"
                                      Content="Reduzir movimento das animações" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveColumnsPanel>
            </ScrollViewer>

            <!-- RECEBIMENTO -->
            <ScrollViewer x:Name="RecebimentoPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SecaoConfiguracoes}" Value="recebimento"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                </ScrollViewer.Style>
                <controls:ResponsiveColumnsPanel MinColumnWidth="360" MaxColumns="2"
                                                 ColumnGap="16" RowGap="16" Margin="0,0,8,12">
                <Border Style="{StaticResource CardBorder}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Permissões de entrada" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Defina o que outros painéis autorizados podem mostrar neste computador."
                                   Style="{StaticResource Subtitulo}" Margin="0,2,0,16" />
                        <CheckBox IsChecked="{Binding AceitarMensagensDeOutrosPaineis}" Margin="0,0,0,12"
                                  Content="Aceitar mensagens de outros painéis" />
                        <Border Margin="28,0,0,14" Padding="13" CornerRadius="9" Background="{DynamicResource SurfaceBrush}">
                            <StackPanel IsEnabled="{Binding AceitarMensagensDeOutrosPaineis}">
                                <CheckBox IsChecked="{Binding AceitarImagensDeOutrosPaineis}" Margin="0,0,0,9"
                                          Content="Aceitar imagens no centro da tela" />
                                <CheckBox IsChecked="{Binding AceitarBotoesComLinks}" Margin="0"
                                          Content="Aceitar botões que abrem links" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="O computador continua identificado na rede como um PC com painel, mesmo quando o recebimento está bloqueado."
                                   Style="{StaticResource Subtitulo}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Painéis autorizados" Style="{StaticResource TituloCard}" />
                        <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource SurfaceBrush}" Margin="0,8,0,14">
                            <TextBlock Text="{Binding StatusReceptorEmbutido}" Style="{StaticResource Subtitulo}" FontSize="12" />
                        </Border>
                        <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PaineisPareados}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding PanelName}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Content="Bloquear"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.RemoverPainelPareadoCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Nenhum painel pareado ainda." FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding PaineisPareados.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                </controls:ResponsiveColumnsPanel>
            </ScrollViewer>

            <!-- PAINEL E REDE -->
            <ScrollViewer x:Name="GeralPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SecaoConfiguracoes}" Value="geral"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                </ScrollViewer.Style>
                <controls:ResponsiveColumnsPanel MinColumnWidth="360" MaxColumns="2"
                                                 ColumnGap="16" RowGap="16" Margin="0,0,8,12">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Identificação" Style="{StaticResource TituloCard}" />
                            <TextBlock Text="Este nome aparece apenas no histórico e nos logs técnicos."
                                       Style="{StaticResource Subtitulo}" Margin="0,2,0,13" />
                            <TextBlock Text="Nome deste painel" Style="{StaticResource RotuloCampo}" />
                            <TextBox Text="{Binding NomePainel, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Inicialização" Style="{StaticResource TituloCard}" Margin="0,0,0,10" />
                            <CheckBox IsChecked="{Binding IniciarComWindows}" Content="Abrir o Comunicador junto com o Windows" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Sobre este painel" Style="{StaticResource TituloCard}" Margin="0,0,0,7" />
                            <TextBlock Text="Identificador exclusivo local" Style="{StaticResource Subtitulo}" FontSize="12" />
                            <TextBlock Text="{Binding PainelId}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Rede" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Mudanças de porta são salvas agora e entram em vigor na próxima abertura."
                                   Style="{StaticResource Subtitulo}" Margin="0,2,0,16" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Porta TCP" Style="{StaticResource RotuloCampo}" /><TextBox Text="{Binding PortaTcp, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Porta UDP" Style="{StaticResource RotuloCampo}" /><TextBox Text="{Binding PortaUdp, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Descoberta (s)" Style="{StaticResource RotuloCampo}" /><TextBox Text="{Binding IntervaloDescobertaSegundos, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Verificação (s)" Style="{StaticResource RotuloCampo}" /><TextBox Text="{Binding IntervaloPingSegundos, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </controls:ResponsiveColumnsPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
