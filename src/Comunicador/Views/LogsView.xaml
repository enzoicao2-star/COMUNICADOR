<UserControl x:Class="Comunicador.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Logs" Style="{StaticResource TituloSecao}" />
                <TextBlock Text="Erros e eventos técnicos reunidos dos seus painéis e receptores."
                           Style="{StaticResource Subtitulo}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button Style="{StaticResource BotaoPrimario}" Command="{Binding AtualizarCommand}" Margin="0,0,8,0"
                        Content="Coletar e atualizar" />
                <Button Style="{StaticResource BotaoSecundario}" Command="{Binding ExportarCommand}" Margin="0,0,8,0"
                        Content="Salvar TXT" />
                <Button Style="{StaticResource BotaoSecundario}" Command="{Binding LimparCommand}" Content="Limpar local" />
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por máquina, categoria, mensagem ou detalhes" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Niveis}" SelectedItem="{Binding Nivel}" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Origens}" SelectedItem="{Binding Origem}" />
        </Grid>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12" CornerRadius="6" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding Status, Converter={StaticResource TextoParaVisibilidadeConverter}}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ItensFiltrados}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardListaBorder}" Margin="0,0,0,8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Nivel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Mensagem}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Subtitulo}" Margin="0,3,0,0">
                                        <Run Text="{Binding OrigemNome}" FontWeight="SemiBold" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding Categoria}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detalhes}" FontFamily="Consolas" FontSize="11" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding Detalhes, Converter={StaticResource TextoParaVisibilidadeConverter}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource Subtitulo}" Margin="14,0,0,0"
                                           Text="{Binding TimestampUtc, StringFormat={}{0:dd/MM HH:mm:ss}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
