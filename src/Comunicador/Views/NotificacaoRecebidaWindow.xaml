<Window x:Class="Comunicador.Views.NotificacaoRecebidaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comunicador" Width="340" Height="220"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="DeSenderText" Style="{StaticResource Subtitulo}" />
        <TextBlock x:Name="TituloText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,6" />
        <TextBlock x:Name="MensagemText" FontSize="12" TextWrapping="Wrap" />

        <StackPanel x:Name="RespostaPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBox x:Name="RespostaBox" KeyDown="RespostaBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource BotaoSecundario}" Content="Fechar" Click="Fechar_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource BotaoPrimario}" Content="Responder" Click="Responder_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="OkPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource BotaoPrimario}" Content="OK" Click="Fechar_Click" />
        </StackPanel>
    </StackPanel>
</Window>
