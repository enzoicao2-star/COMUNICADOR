<UserControl x:Class="Comunicador.Views.AcoesComputadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <Border Style="{StaticResource CardListaBorder}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ComputadorGerenciado.NomeExibicao}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" CornerRadius="9" Padding="7,4"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" ToolTip="Ping individual medido pelo painel">
                                <TextBlock Text="{Binding ComputadorGerenciado.PingTexto}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock Text="{Binding ComputadorGerenciado.Nome}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ComputadorGerenciado.EnderecoIpExibicao}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding ComputadorGerenciado.Status, Converter={StaticResource StatusComputadorToBrushConverter}}" />
                                <TextBlock Text="{Binding ComputadorGerenciado.Status, Converter={StaticResource StatusComputadorToTextoConverter}}"
                                           FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding ComputadorGerenciado.StatusVersoes}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="8" Padding="8,3"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding ComputadorGerenciado.TextoTipoInstalacao}" FontSize="10" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Ações do computador" Style="{StaticResource Subtitulo}" FontSize="11"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ComputadorGerenciado.DiagnosticoConexao}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding ComputadorGerenciado.UltimoEnvioResumo}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   ToolTip="{Binding ComputadorGerenciado.UltimoEnvioDetalhe}" />
                        <TextBlock Text="{Binding ComputadorGerenciado.UltimoEnvioErro}" FontSize="11"
                                   Foreground="#B44545" TextWrapping="Wrap"
                                   ToolTip="{Binding ComputadorGerenciado.UltimoEnvioDetalhe}"
                                   Visibility="{Binding ComputadorGerenciado.UltimoEnvioErro, Converter={StaticResource TextoParaVisibilidadeConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Ações disponíveis" Style="{StaticResource TituloCard}" Margin="2,0,0,4" />
            <TextBlock Text="Cada ação aparece de acordo com as permissões deste painel." Style="{StaticResource Subtitulo}"
                       Margin="2,0,0,14" />

            <WrapPanel Margin="0,0,0,8">
                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoPrimario}" Click="EnviarImagem_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#26FFFFFF" VerticalAlignment="Top">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enviar imagem" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Escolha imagem, vídeo ou carrossel" FontSize="11" Foreground="#E9E5FF"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="MostrarMidias_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Mídias na tela" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Ver, mover, ajustar tempo ou remover" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="EnviarMensagem_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enviar mensagem" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Compor uma mensagem para este PC (beta)" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="MostrarCmd_Click"
                        Visibility="{Binding ComputadorGerenciado.PodeUsarCmdRemoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CMD remoto" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Executar ou cancelar um comando sem admin" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="Configurar_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Configurar computador" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Apelido, badges e permissões" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </WrapPanel>

            <Border x:Name="MediaPanel" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Mídias na tela" Style="{StaticResource TituloCard}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                                    Padding="10,4" Margin="0,0,8,0" Click="AtualizarMidias_Click" />
                            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                                    Padding="10,4" Click="OcultarMidias_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="A miniatura mostra a posição atual da imagem neste monitor. Arraste a imagem para movê-la."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ItemsControl x:Name="MidiasNaTelaLista" ItemsSource="{Binding ImagensPersistentesAtivas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                            <TextBlock Text="{Binding MonitorTexto}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="  ·  " Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding PrazoTexto}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Canvas Width="320" Height="180" Background="#10141C" HorizontalAlignment="Left"
                                                ClipToBounds="True" MouseMove="MidiaPreview_MouseMove"
                                                MouseLeftButtonUp="MidiaPreview_MouseLeftButtonUp">
                                            <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                                    Canvas.Left="{Binding PreviewLeft}" Canvas.Top="{Binding PreviewTop}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                                    MouseLeftButtonDown="MidiaPreview_MouseLeftButtonDown"
                                                    ToolTip="Arraste para mover a imagem">
                                                <Image Source="{Binding Miniatura}" Stretch="Fill" />
                                            </Border>
                                        </Canvas>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="←" Tag="left" Click="ControlarMidia_Click" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" />
                                            <Button Content="↑" Tag="up" Click="ControlarMidia_Click" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" />
                                            <Button Content="↓" Tag="down" Click="ControlarMidia_Click" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" />
                                            <Button Content="→" Tag="right" Click="ControlarMidia_Click" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,4" />
                                            <Button Content="Menor" Tag="smaller" Click="ControlarMidia_Click" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" />
                                            <Button Content="Maior" Tag="larger" Click="ControlarMidia_Click" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,4" />
                                            <TextBlock Text="Remover em" VerticalAlignment="Center" Margin="0,0,5,4" />
                                            <TextBox Width="65" Text="{Binding TempoSegundos, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" Margin="0,0,5,4" />
                                            <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <Button Content="Aplicar tempo" Tag="set_timeout" Click="ControlarMidia_Click"
                                                    Style="{StaticResource BotaoSecundario}" Margin="0,0,6,4" />
                                            <Button Content="Remover agora" Tag="remove" Click="ControlarMidia_Click"
                                                    Style="{StaticResource BotaoSecundario}" Margin="0,0,0,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Se não aparecer nenhuma mídia, clique em Atualizar para consultar o receptor."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="CmdPanel" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="CMD remoto" Style="{StaticResource TituloCard}" />
                        <Button Content="Fechar" HorizontalAlignment="Right" Padding="10,4"
                                Style="{StaticResource BotaoSecundario}" Click="OcultarCmd_Click" />
                    </Grid>
                    <TextBlock Text="Executa no contexto normal desta conta, sem privilégios de administrador do Windows. A janela do CMD fica oculta."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <TextBox Text="{Binding ComandoRemoto, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                             ToolTip="Comando do CMD (até 500 caracteres)" />
                    <WrapPanel Margin="0,9,0,9">
                        <Button Content="Executar no computador" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding EnviarCmdRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancelar comando" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding CancelarCmdRemotoCommand}" />
                    </WrapPanel>
                    <controls:TerminalLoader Margin="0,0,0,9" HorizontalAlignment="Left"
                        Visibility="{Binding ComandoRemotoEmAndamento, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Aguardando resposta do comando remoto" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                        <TextBlock Text="{Binding ResultadoComandoRemoto}" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusAcoes" Text="{Binding StatusMensagem}" Style="{StaticResource Subtitulo}"
                       TextWrapping="Wrap" Margin="2,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
