<UserControl x:Class="Comunicador.Views.AcoesComputadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <Border Style="{StaticResource CardListaBorder}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ComputadorGerenciado.NomeExibicao}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" CornerRadius="9" Padding="7,4"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" ToolTip="Ping individual medido pelo painel">
                                <TextBlock Text="{Binding ComputadorGerenciado.PingTexto}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock Text="{Binding ComputadorGerenciado.Nome}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ComputadorGerenciado.EnderecoIpExibicao}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding ComputadorGerenciado.Status, Converter={StaticResource StatusComputadorToBrushConverter}}" />
                                <TextBlock Text="{Binding ComputadorGerenciado.Status, Converter={StaticResource StatusComputadorToTextoConverter}}"
                                           FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding ComputadorGerenciado.StatusVersoes}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="8" Padding="8,3"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding ComputadorGerenciado.TextoTipoInstalacao}" FontSize="10" />
                            </Border>
                        </Grid>
                        <TextBlock Text="Ações do computador" Style="{StaticResource Subtitulo}" FontSize="11"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Ações disponíveis" Style="{StaticResource TituloCard}" Margin="2,0,0,4" />
            <TextBlock Text="Cada ação aparece de acordo com as permissões deste painel." Style="{StaticResource Subtitulo}"
                       Margin="2,0,0,14" />

            <WrapPanel Margin="0,0,0,8">
                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoPrimario}" Click="EnviarImagem_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#26FFFFFF" VerticalAlignment="Top">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enviar imagem" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Escolha imagem, vídeo ou carrossel" FontSize="11" Foreground="#E9E5FF"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="EnviarMensagem_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enviar mensagem" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Compor uma mensagem para este PC (beta)" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="MostrarCmd_Click"
                        Visibility="{Binding ComputadorGerenciado.PodeUsarCmdRemoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CMD remoto" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Executar ou cancelar um comando sem admin" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Width="252" Height="90" Margin="0,0,10,10" Padding="12"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Style="{StaticResource BotaoSecundario}" Click="Configurar_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Configurar computador" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Apelido, badges e permissões" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </WrapPanel>

            <Border x:Name="CmdPanel" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="CMD remoto" Style="{StaticResource TituloCard}" />
                        <Button Content="Fechar" HorizontalAlignment="Right" Padding="10,4"
                                Style="{StaticResource BotaoSecundario}" Click="OcultarCmd_Click" />
                    </Grid>
                    <TextBlock Text="Executa no contexto normal desta conta, sem privilégios de administrador do Windows. A janela do CMD fica oculta."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <TextBox Text="{Binding ComandoRemoto, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                             ToolTip="Comando do CMD (até 500 caracteres)" />
                    <WrapPanel Margin="0,9,0,9">
                        <Button Content="Executar no computador" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding EnviarCmdRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancelar comando" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding CancelarCmdRemotoCommand}" />
                    </WrapPanel>
                    <controls:TerminalLoader Margin="0,0,0,9" HorizontalAlignment="Left"
                        Visibility="{Binding ComandoRemotoEmAndamento, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Aguardando resposta do comando remoto" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                        <TextBlock Text="{Binding ResultadoComandoRemoto}" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusAcoes" Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="2,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
