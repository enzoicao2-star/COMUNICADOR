<Window x:Class="Comunicador.Views.AcoesComputadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ações do computador" Width="720" Height="660" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding ComputadorGerenciado.NomeExibicao}" Style="{StaticResource TituloSecao}" />
            <TextBlock Text="Escolha o que deseja fazer neste computador." Style="{StaticResource Subtitulo}" Margin="0,2,0,18" />

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Button Content="Enviar imagem" Height="48" Margin="0,0,8,8" Style="{StaticResource BotaoPrimario}"
                        Click="EnviarImagem_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="Enviar mensagem (beta)" Height="48" Margin="0,0,0,8" Style="{StaticResource BotaoSecundario}"
                        Click="EnviarMensagem_Click"
                        Visibility="{Binding PodeEnviarMidias, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="Configurar computador" Height="44" Margin="0,0,8,8" Style="{StaticResource BotaoSecundario}"
                        Click="Configurar_Click" />
                <Button Content="CMD remoto" Height="44" Margin="0,0,0,8" Style="{StaticResource BotaoSecundario}"
                        Click="MostrarCmd_Click"
                        Visibility="{Binding ComputadorGerenciado.PodeUsarCmdRemoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </UniformGrid>

            <Border x:Name="CmdPanel" Style="{StaticResource CardBorder}" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="CMD remoto" Style="{StaticResource TituloCard}" />
                    <TextBlock Text="Executa no contexto normal desta conta, sem privilégios de administrador do Windows. A janela do CMD fica oculta."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <TextBox Text="{Binding ComandoRemoto, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                             ToolTip="Comando do CMD (até 500 caracteres)" />
                    <WrapPanel Margin="0,9,0,9">
                        <Button Content="Executar no computador" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding EnviarCmdRemotoCommand}" CommandParameter="{Binding ComputadorGerenciado}" Margin="0,0,8,0" />
                        <Button Content="Cancelar comando" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding CancelarCmdRemotoCommand}" />
                    </WrapPanel>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                        <TextBlock Text="{Binding ResultadoComandoRemoto}" FontFamily="Consolas" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusAcoes" Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right"
                    Margin="0,18,0,0" Click="Fechar_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
