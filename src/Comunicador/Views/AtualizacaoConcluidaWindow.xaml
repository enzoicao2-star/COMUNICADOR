<Window x:Class="Comunicador.Views.AtualizacaoConcluidaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O que mudou no Comunicador" Width="700" Height="560"
        MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="O que mudou" Style="{StaticResource TituloSecao}" Margin="0,0,0,14" />
        <TextBox x:Name="Detalhes" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontSize="14" Padding="14" Foreground="{DynamicResource TextPrimaryBrush}"
                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copiar alterações" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Click="Copiar_OnClick" />
            <Button Content="Fechar" Style="{StaticResource BotaoPrimario}" Click="Fechar_OnClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
