<UserControl x:Class="Comunicador.Views.MensagensView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comunicador.Controls">
    <UserControl.Resources>
        <Style x:Key="LinhaDestinatario" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PainelImagemRevelado" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExibirImagemCentral}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
    <DockPanel x:Name="PainelPrincipal" LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Mensagens" Style="{StaticResource TituloSecao}" />
                <TextBlock Text="Monte o aviso, escolha os computadores e envie pela rede local."
                           Style="{StaticResource Subtitulo}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="12"
                    Padding="10,5" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="IndicadorEnvio" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TextoAtrasoEnvioImagem}" Style="{StaticResource Subtitulo}" FontSize="11" Margin="7,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border DockPanel.Dock="Bottom" x:Name="BarraEnvio" Margin="0,12,0,0" Padding="14,10"
                CornerRadius="12" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pronto para enviar" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BotaoSecundario}" Command="{Binding PrevisualizarCommand}"
                            Content="Testar no meu PC" Height="40" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Ao alterar o papel de parede ou a tela de bloqueio, confira a miniatura; nenhuma imagem abre na tela do destinatário." />
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding EnviarCommand}"
                            Height="40" Padding="26,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Enviar agora" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <controls:ResponsiveColumnsPanel x:Name="PainelCardsMensagem" MinColumnWidth="340" MaxColumns="2"
                                             ColumnGap="10" RowGap="10" Margin="0,0,8,8">
                <Border x:Name="CardComposicao" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExibirImagemCentral}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SidebarSelectedBrush}">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Conteúdo" Style="{StaticResource TituloCard}" />
                                <TextBlock Text="O que aparecerá no computador escolhido" Style="{StaticResource Subtitulo}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Selecionar modelo" Style="{StaticResource BotaoSecundario}"
                                    Click="AbrirModelos_Click" Margin="0,0,7,0"
                                    Visibility="{Binding PodeSelecionarModelo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Salvar aviso como modelo" Style="{StaticResource BotaoSecundario}"
                                    Click="AbrirNovoModelo_Click"
                                    Visibility="{Binding PodeAbrirBiblioteca, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                        <TextBlock Text="Título" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,9" />
                        <TextBlock Text="Mensagem" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000"
                                 Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="11,8" />
                    </StackPanel>
                </Border>

                <Border x:Name="CardDestinatarios" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoEnvioIndividual}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Enviar para" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Escolha um ou vários computadores sem sair desta tela."
                                   Style="{StaticResource Subtitulo}" Margin="0,2,0,9" />
                        <WrapPanel>
                            <Button Content="Selecionar computadores" Style="{StaticResource BotaoPrimario}"
                                    Click="AbrirDestinatarios_Click" Margin="0,0,7,0" />
                            <Button Content="Selecionar grupo" Style="{StaticResource BotaoSecundario}"
                                    Click="AbrirGrupos_Click"
                                    Visibility="{Binding PodeSelecionarGrupo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TextoDestinatariosSelecionados}" Style="{StaticResource Subtitulo}"
                                   FontSize="11" Margin="1,7,0,0" />
                        <TextBlock Text="Nenhum computador pareado. Abra Computadores para conectar." FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Destinatarios.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Abrir carrossel de imagens…" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding AbrirCarrosselCommand}" Margin="0,9,0,0"
                                Visibility="{Binding PodeGerenciarCarrossel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border x:Name="CardFormato" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Formato do aviso" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Escolha onde e como o conteúdo deverá chamar atenção."
                                   Style="{StaticResource Subtitulo}" Margin="0,2,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="9" Padding="11,8" Background="{DynamicResource SurfaceBrush}">
                                <CheckBox IsChecked="{Binding ExibirImagemCentral}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Imagem no centro" FontWeight="SemiBold" />
                                        <TextBlock Text="Controle por monitor" Style="{StaticResource Subtitulo}" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="9" Padding="11,8" Background="{DynamicResource SurfaceBrush}">
                                <CheckBox IsChecked="{Binding ExibirAvisoObrigatorio}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Confirmação obrigatória" FontWeight="SemiBold" />
                                        <TextBlock Text="Também funciona no canto" Style="{StaticResource Subtitulo}" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Grid.Column="4" CornerRadius="9" Padding="11,8" Background="{DynamicResource SurfaceBrush}">
                                <CheckBox IsChecked="{Binding ExibirMensagemCentral}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Mensagem no centro" FontWeight="SemiBold" />
                                        <TextBlock Text="Mantém respostas e botões" Style="{StaticResource Subtitulo}" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding DescricaoFormato}" Style="{StaticResource Subtitulo}"
                                   Margin="2,10,0,0" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="CardAparencia" Padding="14"
                        controls:ResponsiveColumnsPanel.ColumnSpan="99">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ExibirAvisoObrigatorio}" Value="True" />
                                        <Condition Binding="{Binding AlterarImagemSistema}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Aparência e som" Style="{StaticResource TituloCard}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cor de destaque" Style="{StaticResource RotuloCampo}" />
                                <controls:ColorPickerPopover Width="160"
                                    SelectedColor="{Binding CorDestaque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Posição do aviso" Style="{StaticResource RotuloCampo}" />
                                <ComboBox SelectedValue="{Binding PosicaoAviso}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Inferior direito" Tag="bottom_right" />
                                    <ComboBoxItem Content="Superior direito" Tag="top_right" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tamanho do texto" Style="{StaticResource RotuloCampo}" />
                                <Slider Minimum="80" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding EscalaTexto}" Tag="%" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tempo do aviso comum" Style="{StaticResource RotuloCampo}" />
                                <Slider Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding TempoAvisoSegundos}" Tag=" s" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding TocarSom}" Content="Tocar som" VerticalAlignment="Center" Margin="0" />
                            <ComboBox Grid.Column="2" SelectedValue="{Binding TipoSom}" SelectedValuePath="Tag"
                                      IsEnabled="{Binding TocarSom}">
                                <ComboBoxItem Content="Informação" Tag="information" />
                                <ComboBoxItem Content="Aviso" Tag="warning" />
                                <ComboBoxItem Content="Erro" Tag="error" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="CardImagem" Style="{StaticResource PainelImagemRevelado}" Padding="14"
                        controls:ResponsiveColumnsPanel.ColumnSpan="99">
                    <StackPanel>
                        <TextBlock Text="Imagem, vídeo ou áudio" Style="{StaticResource TituloCard}" />
                        <TextBlock Text="Carregue uma vez e reutilize nos monitores escolhidos. Áudios tocam em segundo plano."
                                   Style="{StaticResource Subtitulo}" Margin="0,2,0,13" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="215" /><ColumnDefinition Width="15" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="150" CornerRadius="9" Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="7">
                                <Grid>
                                    <controls:AnimatedImage DataBase64="{Binding ImagemPreviewBase64}"
                                                            MimeType="{Binding MimeImagem}" Stretch="Uniform"
                                                            Visibility="{Binding TemImagem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemImagem}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TipoMidiaTexto}" Style="{StaticResource Subtitulo}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding NomeMidia, TargetNullValue=Nenhuma mídia selecionada}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding TipoMidiaTexto}" Style="{StaticResource Subtitulo}"
                                           FontSize="11" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,7">
                                    <Button Style="{StaticResource BotaoSecundario}" Content="Imagem"
                                            Command="{Binding SelecionarImagemCommand}" Margin="0,0,7,6" />
                                    <Button Style="{StaticResource BotaoSecundario}" Content="Vídeo"
                                            Command="{Binding SelecionarVideoCommand}" Margin="0,0,7,6" />
                                    <Button Style="{StaticResource BotaoSecundario}" Content="Áudio"
                                            Command="{Binding SelecionarAudioCommand}" Margin="0,0,7,6" />
                                    <Button Style="{StaticResource BotaoSecundario}" Content="Remover"
                                            Command="{Binding RemoverImagemCommand}" IsEnabled="{Binding TemMidia}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <TextBlock Text="Imagem PNG/JPEG/BMP até 4 MB · GIF até 16 MB · vídeo MP4/WMV até 24 MB · áudio MP3/WAV até 12 MB"
                                           Style="{StaticResource Subtitulo}" FontSize="11" />
                                <CheckBox IsChecked="{Binding DefinirComoPapelDeParede}"
                                          IsEnabled="{Binding PodeAlterarPapelParede}"
                                          Content="Definir esta imagem como papel de parede remoto"
                                          Margin="0,9,0,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ImagemCompativelPapelParede}" Value="True" />
                                                        <Condition Binding="{Binding PodeAlterarPapelParede}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding DefinirComoTelaDeBloqueio}"
                                          IsEnabled="{Binding PodeAlterarPapelParede}"
                                          Content="Definir esta imagem como tela de bloqueio remota"
                                          Margin="0,5,0,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ImagemCompativelPapelParede}" Value="True" />
                                                        <Condition Binding="{Binding PodeAlterarPapelParede}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <TextBlock Text="O papel de parede será alterado sem mostrar a imagem ou abrir um aviso no computador de destino."
                                           TextWrapping="Wrap" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefinirComoPapelDeParede}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="A tela de bloqueio da conta do destinatário será alterada sem abrir a imagem ou um aviso."
                                           TextWrapping="Wrap" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefinirComoTelaDeBloqueio}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemImagemConfigurada}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Enviar a imagem após" Style="{StaticResource RotuloCampo}" />
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBox Width="96" ToolTip="0 envia imediatamente; máximo 3600 segundos"
                                                 Text="{Binding AtrasoEnvioImagemSegundos, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="segundos (0 = agora)" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource Subtitulo}" />
                                    </DockPanel>
                                    <TextBlock Text="Tempo na tela (mínimo 0,5 s)" Style="{StaticResource RotuloCampo}" />
                                    <DockPanel LastChildFill="False">
                                        <TextBox Width="96" ToolTip="Aceita décimos de segundo; mínimo 0,5" Text="{Binding TempoImagemSegundos, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="segundos" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource Subtitulo}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemVideoConfigurado}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox IsChecked="{Binding RepetirVideo}" Content="Repetir vídeo em loop" Margin="0,0,0,5" />
                                    <TextBlock Text="Tempo total quando estiver em loop" Style="{StaticResource RotuloCampo}" />
                                    <DockPanel LastChildFill="False" IsEnabled="{Binding RepetirVideo}">
                                        <TextBox Width="96" Text="{Binding TempoImagemSegundos, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="segundos" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource Subtitulo}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemAudio}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox IsChecked="{Binding RepetirAudio}" Content="Repetir áudio em loop" Margin="0,0,0,5" />
                                    <CheckBox IsChecked="{Binding LimitarDuracaoAudio}" Content="Parar após o tempo definido" Margin="0,0,0,5" />
                                    <TextBlock Text="Tempo de reprodução" Style="{StaticResource RotuloCampo}" />
                                    <DockPanel LastChildFill="False" IsEnabled="{Binding LimitarDuracaoAudio}">
                                        <TextBox Width="96" Text="{Binding TempoImagemSegundos, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="segundos" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource Subtitulo}" />
                                    </DockPanel>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding PermitirFecharImagem}" Margin="0,7,0,0"
                                          Content="Permitir fechar manualmente">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemAudio}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemAudio}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,15,0,13" />
                            <TextBlock Text="Prévia dos monitores escolhidos" Style="{StaticResource RotuloCampo}" />
                            <TextBlock Text="Aparecem somente os monitores dos computadores marcados. A mídia já carregada pode ser reutilizada sem abrir outro seletor."
                                       Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,0,0,9" />
                            <TextBlock Text="Marque um computador em “Enviar para” para escolher o monitor de destino."
                                       FontSize="11" Margin="0,2,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MonitoresDestino.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding MonitoresDestino}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="335" Background="{DynamicResource CardSurfaceBrush}"
                                            BorderBrush="{DynamicResource CardGlassBorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="11" Margin="0,0,9,9">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Resolucao}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border Height="{Binding AlturaPreview}" MinHeight="80" MaxHeight="155"
                                                    Background="#080B11" BorderBrush="#52637C" BorderThickness="1"
                                                    CornerRadius="5" Padding="5">
                                                <ItemsControl ItemsSource="{Binding Midias}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="{Binding PreviewWidth}" MaxHeight="130" Margin="3">
                                                                <Image Source="{Binding ImagemPreview}" MaxHeight="130" Stretch="Uniform" />
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding EhVideo}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Vídeo" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Midias}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="85" />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Slider Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5"
                                                                    IsSnapToTickEnabled="True" Value="{Binding TamanhoPercentual}"
                                                                    Tag="%" Margin="7,0" />
                                                            <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Padding="7,0"
                                                                    Height="26" ToolTip="Remover mídia"
                                                                    Command="{Binding DataContext.RemoverImagemMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <WrapPanel Margin="0,5,0,0">
                                                <Button Style="{StaticResource BotaoPrimario}" Content="Usar mídia carregada"
                                                        Margin="0,0,7,5"
                                                        Command="{Binding DataContext.UsarImagemCarregadaNoMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource BotaoSecundario}" Content="Outra imagem"
                                                        Margin="0,0,0,5"
                                                        Command="{Binding DataContext.AdicionarImagemMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource BotaoSecundario}" Content="Outro vídeo"
                                                        Margin="7,0,0,5"
                                                        Command="{Binding DataContext.AdicionarVideoMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="CardInteracao" Padding="14"
                        controls:ResponsiveColumnsPanel.ColumnSpan="99">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExibirImagemCentral}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AlterarImagemSistema}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" MinWidth="260" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.2*" MinWidth="360" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Interação" Style="{StaticResource TituloCard}" />
                            <CheckBox IsChecked="{Binding PermitirResposta}" Margin="0,9,0,0"
                                      Content="Permitir que a pessoa responda" />
                            <TextBlock Text="Sem resposta, o aviso mostra somente o botão OK."
                                       Style="{StaticResource Subtitulo}" FontSize="11" Margin="29,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Botões e links" Style="{StaticResource RotuloCampo}" />
                            <TextBlock Text="O link abre somente endereços http/https no navegador."
                                       Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Botoes}" Margin="0,0,0,7">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Descricao}" Style="{StaticResource Subtitulo}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" Padding="8,0"
                                                        Height="26" ToolTip="Remover botão"
                                                        Command="{Binding DataContext.RemoverBotaoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NovoBotaoRotulo, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="40" ToolTip="Texto do botão" />
                                <TextBox Grid.Column="2" Text="{Binding NovoBotaoUrl, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="500" ToolTip="Link opcional" />
                                <Button Grid.Column="4" Style="{StaticResource BotaoSecundario}" Content="Adicionar"
                                        Command="{Binding AdicionarBotaoCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </controls:ResponsiveColumnsPanel>
        </ScrollViewer>
    </DockPanel>

    <Grid x:Name="DestinatariosOverlay" Panel.ZIndex="20" Visibility="Collapsed"
          Background="Transparent" MouseDown="FecharOverlayAoClicarFora">
        <Border Width="660" MinHeight="380" MaxHeight="690" Margin="20" Padding="15" HorizontalAlignment="Center"
                VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Selecionar computadores" Style="{StaticResource TituloCard}" FontSize="19" />
                        <TextBlock Text="Marque um ou vários computadores para este aviso."
                                   Style="{StaticResource Subtitulo}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32" Padding="0"
                            Content="×" FontFamily="Segoe UI" Style="{StaticResource BotaoSecundario}"
                            ToolTip="Fechar" Click="FecharDestinatarios_Click" />
                </Grid>
                <TextBox x:Name="FiltroDestinatarios" Grid.Row="1" Margin="0,12,0,9"
                         ToolTip="Filtrar por apelido, nome do computador ou endereço"
                         TextChanged="FiltroDestinatarios_TextChanged" />
                <ListBox x:Name="ListaDestinatarios" Grid.Row="2" MinHeight="180" MaxHeight="490"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardListaBorder}" Padding="10,7" Margin="0,0,0,5">
                                <CheckBox IsChecked="{Binding Selecionado}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Computador.NomeExibicao}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Computador.Nome}" Style="{StaticResource Subtitulo}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding Computador.Status, Converter={StaticResource StatusComputadorToBrushConverter}}" />
                                            <TextBlock Text="{Binding Computador.EnderecoIpExibicao}" Style="{StaticResource Subtitulo}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Selecionar todos" Style="{StaticResource BotaoSecundario}"
                                Click="SelecionarTodosDestinatarios_Click" Margin="0,0,7,0" />
                        <Button Content="Limpar seleção" Style="{StaticResource BotaoSecundario}"
                                Click="LimparDestinatarios_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TextoDestinatariosSelecionados}" Style="{StaticResource Subtitulo}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Concluído" Style="{StaticResource BotaoPrimario}"
                                Click="FecharDestinatarios_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Grid x:Name="ModelosOverlay" Panel.ZIndex="21" Visibility="Collapsed"
          Background="Transparent" MouseDown="FecharOverlayAoClicarFora">
        <Border Width="570" MinHeight="340" MaxHeight="660" Margin="20" Padding="15" HorizontalAlignment="Center"
                VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Modelos compartilhados" Style="{StaticResource TituloCard}" FontSize="19" />
                        <TextBlock Text="Escolha um aviso salvo ou crie um modelo com o conteúdo atual."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32" Padding="0"
                            Content="×" FontFamily="Segoe UI" Style="{StaticResource BotaoSecundario}"
                            ToolTip="Fechar" Click="FecharModelos_Click" />
                </Grid>
                <Border Grid.Row="1" x:Name="CadastroModeloPainel" Margin="0,12,0,9" Padding="10"
                        CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nome do novo modelo" Style="{StaticResource RotuloCampo}" />
                            <TextBox Text="{Binding NovoModeloNome, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                     ToolTip="Dê um nome curto para encontrar este aviso depois" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Salvar modelo" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding SalvarModeloCommand}" Margin="9,18,0,0" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding ModelosMensagem}" SelectedItem="{Binding ModeloSelecionado}"
                             MaxHeight="390" BorderThickness="0" Background="Transparent" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardListaBorder}" Padding="11,9" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelosMensagem.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Ainda não há modelos salvos." FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="O OWNER pode criar o primeiro usando o aviso que está sendo editado."
                                   Style="{StaticResource Subtitulo}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,9" />
                        <Button Content="Cadastrar novo modelo" Style="{StaticResource BotaoPrimario}"
                                Click="MostrarCadastroModelo_Click"
                                Visibility="{Binding PodeAbrirBiblioteca, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Left" Content="Novo modelo" Style="{StaticResource BotaoSecundario}"
                            Click="MostrarCadastroModelo_Click"
                            Visibility="{Binding PodeAbrirBiblioteca, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Excluir" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding RemoverModeloCommand}"
                                IsEnabled="{Binding PodeGerenciarBiblioteca}" Margin="0,0,7,0" />
                        <Button Content="Usar modelo" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding AplicarModeloCommand}" Click="AplicarModelo_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Grid x:Name="GruposOverlay" Panel.ZIndex="22" Visibility="Collapsed"
          Background="Transparent" MouseDown="FecharOverlayAoClicarFora">
        <Border Width="570" MinHeight="340" MaxHeight="660" Margin="20" Padding="15" HorizontalAlignment="Center"
                VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Grupos de computadores" Style="{StaticResource TituloCard}" FontSize="19" />
                        <TextBlock Text="Aplique uma seleção salva ou crie um grupo com os computadores marcados."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32" Padding="0"
                            Content="×" FontFamily="Segoe UI" Style="{StaticResource BotaoSecundario}"
                            ToolTip="Fechar" Click="FecharGrupos_Click" />
                </Grid>
                <Border Grid.Row="1" x:Name="CadastroGrupoPainel" Margin="0,12,0,9" Padding="10"
                        CornerRadius="9" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nome do novo grupo" Style="{StaticResource RotuloCampo}" />
                            <TextBox Text="{Binding NovoGrupoNome, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                     ToolTip="Dê um nome curto para encontrar esse grupo depois" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Computadores…" Style="{StaticResource BotaoSecundario}"
                                Click="AbrirDestinatariosParaGrupo_Click" Margin="8,18,0,0" />
                        <Button Grid.Column="2" Content="Salvar grupo" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding SalvarGrupoCommand}" Margin="8,18,0,0" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding GruposComputadores}" SelectedItem="{Binding GrupoSelecionado}"
                             MaxHeight="330" BorderThickness="0" Background="Transparent" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardListaBorder}" Padding="11,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ComputadorIds.Count, StringFormat={}{0} computadores}"
                                                   Style="{StaticResource Subtitulo}" FontSize="11" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GruposComputadores.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Ainda não há grupos salvos." FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Selecione os computadores na tela e o OWNER pode salvar essa seleção como grupo."
                                   Style="{StaticResource Subtitulo}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,9" />
                        <Button Content="Cadastrar novo grupo" Style="{StaticResource BotaoPrimario}"
                                Click="MostrarCadastroGrupo_Click"
                                Visibility="{Binding PodeAbrirBiblioteca, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,6,0,0" Padding="10,8" CornerRadius="9"
                            Background="{DynamicResource SurfaceBrush}" MaxHeight="150">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GrupoSelecionado}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Computadores neste grupo" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <ScrollViewer MaxHeight="108" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ComputadoresDoGrupoSelecionado}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Left" Content="Novo grupo" Style="{StaticResource BotaoSecundario}"
                            Click="MostrarCadastroGrupo_Click"
                            Visibility="{Binding PodeAbrirBiblioteca, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Excluir" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding RemoverGrupoCommand}"
                                IsEnabled="{Binding PodeGerenciarBiblioteca}" Margin="0,0,7,0" />
                        <Button Content="Aplicar grupo" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding AplicarGrupoCommand}" Click="AplicarGrupo_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    </Grid>
</UserControl>
