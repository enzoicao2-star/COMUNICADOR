<UserControl x:Class="Comunicador.Views.MensagensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Mensagens" Style="{StaticResource TituloSecao}" />
            <TextBlock Text="Envie um aviso imediato para um ou mais computadores." Style="{StaticResource Subtitulo}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="900" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- composicao -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Título" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Mensagem" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000"
                                 Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Padding="11,8" Margin="0,0,0,16" />

                        <Border Background="#F7F7F7" CornerRadius="4" Padding="12,10" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding PermitirResposta}" Margin="0">
                                    <TextBlock Text="Permitir que a pessoa responda" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource Subtitulo}" Margin="30,2,0,0" FontSize="12"
                                           Text="Com isso o aviso mostra uma caixa de resposta; sem isso, mostra só o botão OK." />
                            </StackPanel>
                        </Border>

                        <!-- botoes de resposta rapida, opcionalmente com link -->
                        <Border Background="#F7F7F7" CornerRadius="4" Padding="12,10" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Botões de resposta (opcional)" Style="{StaticResource RotuloCampo}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Subtitulo}" FontSize="12" Margin="0,0,0,10"
                                           Text="Aparecem como botões no aviso. Com link, o botão também abre o endereço no navegador (só http/https)." />

                                <ItemsControl ItemsSource="{Binding Botoes}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Descricao}" Style="{StaticResource Subtitulo}"
                                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" Padding="8,0"
                                                            Height="26" ToolTip="Remover botão"
                                                            Command="{Binding DataContext.RemoverBotaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" MaxLength="40"
                                             Text="{Binding NovoBotaoRotulo, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" MaxLength="500"
                                             Text="{Binding NovoBotaoUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="4" Style="{StaticResource BotaoSecundario}" Content="Adicionar"
                                            Command="{Binding AdicionarBotaoCommand}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,4,0,0"
                                           Text="Esquerda: texto do botão.   Direita: link (deixe vazio para só responder)." />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BotaoPrimario}" Command="{Binding EnviarCommand}" Padding="24,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Enviar" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- destinatarios -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Enviar para" Style="{StaticResource RotuloCampo}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Destinatarios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,6" Margin="0,0,0,2" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F2F2F2" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <CheckBox IsChecked="{Binding Selecionado}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Computador.NomeExibicao}" FontSize="14" />
                                                <TextBlock Text="{Binding Computador.EnderecoIp}" Style="{StaticResource Subtitulo}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Destinatarios.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Subtitulo}"
                                       Text="Nenhum computador pareado ainda. Vá em Computadores para parear." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
