<UserControl x:Class="Comunicador.Views.MensagensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Mensagens" Style="{StaticResource TituloSecao}" Margin="0" />
            <TextBlock Text="Envie um aviso imediato para um ou mais computadores." Style="{StaticResource Subtitulo}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Título" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,14" />

            <TextBlock Text="Mensagem" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000"
                     Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14" />

            <CheckBox Content="Permitir resposta do computador" IsChecked="{Binding PermitirResposta}" Margin="0,0,0,14" />

            <TextBlock Text="Enviar para" Style="{StaticResource Subtitulo}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Destinatarios}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Computador.Nome}" IsChecked="{Binding Selecionado}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nenhum computador pareado ainda. Pareie um computador na aba Computadores."
                       TextWrapping="Wrap" Margin="0,0,0,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Destinatarios.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BotaoPrimario}" Content="Enviar" Command="{Binding EnviarCommand}" />
                <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
