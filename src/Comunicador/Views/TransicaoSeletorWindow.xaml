<Window x:Class="Comunicador.Views.TransicaoSeletorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        Title="Selecionar transição" Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBox x:Name="BuscaTransicoes" DockPanel.Dock="Right" Width="230" Height="36"
                     VerticalContentAlignment="Center" Margin="12,0,0,0"
                     ToolTip="Buscar transição" TextChanged="BuscaTransicoes_TextChanged" />
            <StackPanel>
                <TextBlock x:Name="TituloJanela" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Selecione um efeito para ver a prévia em movimento; depois clique em Definir."
                           Style="{StaticResource Subtitulo}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ListaCategorias" DisplayMemberPath="Nome"
                     SelectionChanged="Categoria_SelectionChanged"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
            <ListBox x:Name="ListaEfeitos" Grid.Column="2" SelectionChanged="Efeito_SelectionChanged"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     Background="Transparent" BorderThickness="0" SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="#F8FAFD" />
                        <Setter Property="BorderBrush" Value="#CFD9E7" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8D78FF" />
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1EEFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="92">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="164" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:TransicaoEfeitoPreview Width="156" Height="86"
                                EffectId="{Binding Id}"
                                PreviewImage="{Binding DataContext.ImagemPreviewTransicoes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                PreviewLabel="{Binding DataContext.TextoPreviewTransicoes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                IsExitPreview="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                VerticalAlignment="Center">
                            <controls:TransicaoEfeitoPreview.Style>
                                <Style TargetType="{x:Type controls:TransicaoEfeitoPreview}">
                                    <Setter Property="TimeMode">
                                        <Setter.Value>
                                            <Binding Path="DataContext.ModoTempoEntrada"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="SpeedPercent">
                                        <Setter.Value>
                                            <Binding Path="DataContext.VelocidadeEntradaPercentual"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="DurationMs">
                                        <Setter.Value>
                                            <Binding Path="DataContext.DuracaoEntradaMs"
                                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="True">
                                            <Setter Property="TimeMode">
                                                <Setter.Value>
                                                    <Binding Path="DataContext.ModoTempoSaida"
                                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="SpeedPercent">
                                                <Setter.Value>
                                                    <Binding Path="DataContext.VelocidadeSaidaPercentual"
                                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="DurationMs">
                                                <Setter.Value>
                                                    <Binding Path="DataContext.DuracaoSaidaMs"
                                                             RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:TransicaoEfeitoPreview.Style>
                            </controls:TransicaoEfeitoPreview>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Prévia em movimento" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TextoSelecao" Text="Selecione uma transição."
                       Style="{StaticResource Subtitulo}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource BotaoSecundario}" Content="Cancelar"
                        IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Definir" Click="Definir_Click" IsDefault="True"
                        Padding="24,9" Background="#8D78FF" Foreground="#10131A" BorderBrush="#8D78FF" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
