<UserControl x:Class="Comunicador.Views.AtualizacaoDisponivelWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="30" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource CardBorder}" Padding="26">
            <StackPanel>
                <TextBlock Text="Nova versão disponível" Style="{StaticResource TituloSecao}" />
                <TextBlock x:Name="VersaoTexto" Style="{StaticResource Subtitulo}" Margin="0,6,0,18" />
                <TextBlock x:Name="ResumoTexto" TextWrapping="Wrap" FontSize="14" />
                <TextBlock x:Name="StatusTexto" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                           Margin="0,16,0,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Agora não" Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,10,0" Click="Adiar_Click" />
                    <Button Content="Atualizar agora" Style="{StaticResource BotaoPrimario}"
                            Click="Atualizar_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
