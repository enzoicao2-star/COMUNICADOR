<Window x:Class="Comunicador.Views.CarrosselWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carrossel de imagens" Width="760" Height="680" MinWidth="610" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Carrossel de imagens" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="As imagens aparecerão no centro da tela, uma por vez, sem mudar o papel de parede. O carrossel continua mesmo com o painel fechado ou após reiniciar o computador."
                       TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Imagens na ordem de exibição" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="ImagesList" Height="165" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,7,0,15">
                    <Button Content="Adicionar imagens" Click="AddImages_Click" Margin="0,0,7,6" />
                    <Button Content="Remover seleção" Click="RemoveImages_Click" Margin="0,0,7,6" />
                    <Button Content="Subir" Click="MoveUp_Click" Margin="0,0,7,6" />
                    <Button Content="Descer" Click="MoveDown_Click" Margin="0,0,7,6" />
                </WrapPanel>

                <TextBlock Text="Computadores de destino" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock Text="Use a mesma seleção de computadores da tela de Mensagens ou marque outros aqui."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
                <ListBox x:Name="RecipientsList" Height="100">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}"
                                      Content="{Binding Computador.NomeExibicao}" Margin="3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Tempo de cada imagem na tela, em segundos" FontWeight="SemiBold" Margin="0,15,0,6" />
                <TextBox x:Name="DurationSeconds" Text="15" Width="65" HorizontalAlignment="Left" />
                <TextBlock Text="Intervalo entre imagens, em minutos" FontWeight="SemiBold" Margin="0,15,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <RadioButton x:Name="FixedRadio" GroupName="Interval" Content="Fixo" IsChecked="True" VerticalAlignment="Center" />
                    <TextBox x:Name="FixedMinutes" Text="5" Width="65" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <RadioButton x:Name="RandomRadio" GroupName="Interval" Content="Aleatório de" VerticalAlignment="Center" />
                    <TextBox x:Name="RandomMin" Text="5" Width="65" Margin="10,0,5,0"
                             IsEnabled="{Binding IsChecked, ElementName=RandomRadio}" />
                    <TextBlock Text="até" VerticalAlignment="Center" />
                    <TextBox x:Name="RandomMax" Text="15" Width="65" Margin="5,0,5,0"
                             IsEnabled="{Binding IsChecked, ElementName=RandomRadio}" />
                    <TextBlock Text="minutos" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="RepeatCheck" Content="Repetir: após a última, voltar para a primeira até eu desligar"
                          IsChecked="True" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar x:Name="TransferProgress" Height="9" Minimum="0" Maximum="1" Value="0" />
            <TextBlock x:Name="StatusText" Text="Pronto para configurar." TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StopButton" Content="Desligar carrossel nos selecionados"
                        Click="Stop_Click" Margin="0,0,8,0" />
                <Button x:Name="StartButton" Content="Iniciar carrossel" Click="Start_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
