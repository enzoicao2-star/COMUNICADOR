<UserControl x:Class="Comunicador.Views.CarrosselView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid x:Name="Root">
        <Grid Margin="28,18,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Carrossel de imagens" Style="{StaticResource TituloSecao}" />
                <TextBlock Text="Organize as imagens, escolha os computadores e ajuste a exibição."
                           Style="{StaticResource Subtitulo}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Sequência de imagens" Style="{StaticResource TituloCard}" />
                            <TextBlock x:Name="ImageCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Subtitulo}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <ListBox x:Name="ImagesList" MinHeight="100" SelectionMode="Extended"
                                     Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ImageEmptyHint" Text="Adicione imagens PNG ou JPEG para montar a sequência."
                                       Style="{StaticResource Subtitulo}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="16" IsHitTestVisible="False" TextWrapping="Wrap" />
                        </Grid>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Left">
                            <Button Content="Adicionar imagens" Style="{StaticResource BotaoPrimario}"
                                    Click="AddImages_Click" Margin="0,0,7,0" />
                            <Button Content="Remover seleção" Style="{StaticResource BotaoSecundario}"
                                    Click="RemoveImages_Click" Margin="0,0,7,0" />
                            <Button Content="Subir" Style="{StaticResource BotaoSecundario}"
                                    Click="MoveUp_Click" Margin="0,0,7,0" />
                            <Button Content="Descer" Style="{StaticResource BotaoSecundario}"
                                    Click="MoveDown_Click" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Destino e exibição" Style="{StaticResource TituloCard}" />
                        <Grid Margin="0,8,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="Selecionar computadores" Style="{StaticResource BotaoSecundario}"
                                    Click="OpenRecipients_Click" />
                            <TextBlock x:Name="SelectedRecipientsCount" Grid.Column="1" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="8,0,0,0"
                                       Style="{StaticResource Subtitulo}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,3,0,8" />
                        <TextBlock Text="Como as imagens aparecem" Style="{StaticResource RotuloCampo}" />
                        <RadioButton x:Name="CenterRadio" GroupName="DisplayMode" Content="Imagem no centro da tela"
                                     IsChecked="True" Margin="0,0,0,3" />
                        <RadioButton x:Name="MouseTrailRadio" GroupName="DisplayMode"
                                     Content="Miniaturas acompanham o movimento do mouse" Margin="0,0,0,7" />

                        <Grid Margin="0,0,0,6" IsEnabled="{Binding IsChecked, ElementName=MouseTrailRadio}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Tempo total do rastro, minutos" VerticalAlignment="Center" />
                            <TextBox x:Name="TrailMinutes" Grid.Column="1" Text="5" />
                        </Grid>
                        <Grid Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=MouseTrailRadio}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Duração de cada miniatura, segundos" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBox x:Name="TrailImageSeconds" Grid.Column="1" Text="1,5" />
                        </Grid>

                        <Grid Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=CenterRadio}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Tempo por imagem, segundos" VerticalAlignment="Center" />
                            <TextBox x:Name="DurationSeconds" Grid.Column="1" Text="15" />
                        </Grid>
                        <TextBlock Text="Intervalo entre imagens, minutos" Style="{StaticResource RotuloCampo}" />
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CenterRadio}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <RadioButton x:Name="FixedRadio" GroupName="Interval" Content="Fixo"
                                             IsChecked="True" VerticalAlignment="Center" />
                                <TextBox x:Name="FixedMinutes" Text="5" Width="70" Margin="8,0,0,0" />
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,3">
                                <RadioButton x:Name="RandomRadio" GroupName="Interval" Content="Aleatório de"
                                             VerticalAlignment="Center" />
                                <TextBox x:Name="RandomMin" Text="5" Width="62" Margin="8,0,5,5"
                                         IsEnabled="{Binding IsChecked, ElementName=RandomRadio}" />
                                <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,5,5" />
                                <TextBox x:Name="RandomMax" Text="15" Width="62" Margin="0,0,5,5"
                                         IsEnabled="{Binding IsChecked, ElementName=RandomRadio}" />
                                <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,0,5" />
                            </WrapPanel>
                            <CheckBox x:Name="RepeatCheck" Content="Repetir até eu desligar" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="StatusText" Text="Pronto para configurar."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ProgressBar x:Name="TransferProgress" Height="7" Margin="0,8,0,0"
                                     Minimum="0" Maximum="1" Value="0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="CancelTransferButton" Content="Cancelar envio"
                                Style="{StaticResource BotaoSecundario}" Visibility="Collapsed"
                                Click="CancelTransfer_Click" Margin="0,0,8,0" />
                        <Button x:Name="StopButton" Content="Parar carrossel"
                                Style="{StaticResource BotaoSecundario}"
                                Click="Stop_Click" Margin="0,0,8,0" />
                        <Button x:Name="StartButton" Content="Aplicar carrossel"
                                Style="{StaticResource BotaoPrimario}" Click="Start_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="RecipientsOverlay" Panel.ZIndex="21" Visibility="Collapsed"
              Background="Transparent" MouseDown="Overlay_MouseDown">
            <Border Width="650" MinHeight="380" MaxHeight="670" Margin="20" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,48,12">
                            <TextBlock Text="Selecionar computadores" Style="{StaticResource TituloCard}" FontSize="19" />
                            <TextBlock Text="Marque um ou mais computadores para receber o carrossel."
                                       Style="{StaticResource Subtitulo}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32"
                                Padding="0" Content="×" FontFamily="Segoe UI"
                                Style="{StaticResource BotaoSecundario}" ToolTip="Fechar"
                                Click="CloseRecipients_Click" />
                    </Grid>
                    <TextBox x:Name="FilterRecipients" Grid.Row="1" Margin="0,0,0,9"
                             ToolTip="Filtrar por apelido, nome do computador ou endereço IP"
                             TextChanged="FilterRecipients_TextChanged" />
                    <ListBox x:Name="RecipientsList" Grid.Row="2" MinHeight="180" MaxHeight="470"
                             Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}"
                                          Content="{Binding Computador.NomeExibicao}" Margin="8,5"
                                          Checked="RecipientSelectionChanged" Unchecked="RecipientSelectionChanged" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Selecionar todos" Style="{StaticResource BotaoSecundario}"
                                Click="SelectAllRecipients_Click" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Limpar seleção" Style="{StaticResource BotaoSecundario}"
                                Click="ClearRecipients_Click" />
                        <TextBlock x:Name="RecipientsCount" Grid.Column="2" VerticalAlignment="Center"
                                   Margin="12,0" Style="{StaticResource Subtitulo}" />
                        <Button Grid.Column="3" Content="Concluído" Style="{StaticResource BotaoPrimario}"
                                Click="CloseRecipients_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
