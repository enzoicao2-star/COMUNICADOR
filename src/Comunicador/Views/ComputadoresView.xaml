<UserControl x:Class="Comunicador.Views.ComputadoresView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Computadores" Style="{StaticResource TituloSecao}" Margin="0" />
                <TextBlock Text="Receptores descobertos automaticamente na rede local." Style="{StaticResource Subtitulo}" />
            </StackPanel>
            <Button Style="{StaticResource BotaoSecundario}" Content="Procurar agora" Margin="24,0,0,0"
                    VerticalAlignment="Center" Command="{Binding AtualizarAgoraCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMensagem}" Style="{StaticResource Subtitulo}"
                    Margin="0,0,0,12" Visibility="{Binding StatusMensagem, Converter={StaticResource TextoParaVisibilidadeConverter}}" />

        <TextBlock DockPanel.Dock="Top" Text="Nenhum computador encontrado ainda. Instale o receptor.py nas outras máquinas — ele aparecerá aqui automaticamente."
                   TextWrapping="Wrap" Margin="0,40,0,0" HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Computadores.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Computadores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,14,0"
                                         Fill="{Binding Status, Converter={StaticResource StatusComputadorToBrushConverter}}"
                                         VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Style="{StaticResource Subtitulo}">
                                        <Run Text="{Binding EnderecoIp, Mode=OneWay}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding PortaTcp, Mode=OneWay}" />
                                        <Run Text="  •  " />
                                        <Run Text="{Binding Status, Converter={StaticResource StatusComputadorToTextoConverter}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                                        Content="{Binding Pareado, Converter={StaticResource PareadoToTextoConverter}}"
                                        Command="{Binding ElementName=Raiz, Path=DataContext.PairearCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Grid.Column="3" Style="{StaticResource BotaoSecundario}" Content="Remover"
                                        Command="{Binding ElementName=Raiz, Path=DataContext.RemoverCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
