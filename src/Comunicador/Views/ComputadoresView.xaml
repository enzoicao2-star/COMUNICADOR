<UserControl x:Class="Comunicador.Views.ComputadoresView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comunicador.Controls">
    <UserControl.Resources>
        <Style x:Key="BadgeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Computadores" Style="{StaticResource TituloSecao}" />
                <TextBlock Text="Máquinas que podem receber seus avisos nesta rede." Style="{StaticResource Subtitulo}" />
            </StackPanel>
            <Button Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Command="{Binding AtualizarAgoraCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Procurar agora" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Adicionar manualmente" Style="{StaticResource TituloCard}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Subtitulo}" Margin="0,0,0,12"
                           Text="Se a máquina não aparecer sozinha, digite o IP dela para conectar mesmo assim." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NovoIp, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Text="{Binding NovaPorta, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="4" Style="{StaticResource BotaoPrimario}" Content="Adicionar"
                            Command="{Binding AdicionarManualCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12" CornerRadius="4" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StatusMensagem, Converter={StaticResource TextoParaVisibilidadeConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMensagem}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,48,0,0" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Computadores.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                       Foreground="{StaticResource UnknownBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Nenhum computador ainda" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource Subtitulo}" HorizontalAlignment="Center" MaxWidth="380"
                       TextAlignment="Center"
                       Text="Instale o receptor nas outras máquinas — elas aparecem aqui sozinhas assim que conectarem." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Computadores}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,14">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardListaBorder}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemPainel}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0F0F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemPainel}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- modo leitura -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EmEdicao}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding NomeExibicao}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Nome, StringFormat=({0})}" Style="{StaticResource Subtitulo}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding TemApelido, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Margin="9,0,0,0" Padding="7,2" CornerRadius="8" Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding TemPainel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="PAINEL" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <WrapPanel Margin="0,7,0,1">
                                        <controls:InteractiveBadge Text="OWNER" Color="#F2B84B" Icon="Coroa"
                                                                   BadgeStyle="Holográfica" Glow="True" Interactive="True"
                                                                   Margin="0,0,8,5"
                                                                   Visibility="{Binding ExibirOwnerPadrao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ItemsControl ItemsSource="{Binding Badges}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BadgeButton}" Margin="0,0,8,5"
                                                            ToolTip="Abra a edição deste painel e clique para alterar"
                                                            Command="{Binding ElementName=Raiz, Path=DataContext.EditarBadgeCommand}"
                                                            CommandParameter="{Binding}">
                                                        <controls:InteractiveBadge Text="{Binding Texto}" Color="{Binding Cor}"
                                                                                   Icon="{Binding Icone}" BadgeStyle="{Binding Estilo}"
                                                                                   CustomIconBase64="{Binding IconePersonalizadoBase64}"
                                                                                   Glow="{Binding Brilho}" Interactive="{Binding EfeitoMouse}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <!-- modo edicao do apelido -->
                                    <StackPanel Visibility="{Binding EmEdicao, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,3,12,8">
                                        <Grid Margin="0,0,0,7">
                                            <TextBlock Text="Editar este painel" Style="{StaticResource TituloCard}" VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                                                    Style="{StaticResource BotaoSecundario}" ToolTip="Fechar sem aplicar"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.FecharEdicaoCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Nome público" Style="{StaticResource RotuloCampo}" />
                                        <TextBox MaxLength="60" Text="{Binding Apelido, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Badges deste computador" Style="{StaticResource RotuloCampo}" Margin="0,10,0,3" />
                                        <TextBlock Text="Clique em uma badge salva para carregá-la no editor."
                                                   Style="{StaticResource Subtitulo}" FontSize="11" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Badges}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,9,6">
                                                        <Button Style="{StaticResource BadgeButton}"
                                                                Command="{Binding ElementName=Raiz, Path=DataContext.EditarBadgeCommand}"
                                                                CommandParameter="{Binding}">
                                                            <controls:InteractiveBadge Text="{Binding Texto}" Color="{Binding Cor}" Icon="{Binding Icone}"
                                                                                       BadgeStyle="{Binding Estilo}" CustomIconBase64="{Binding IconePersonalizadoBase64}"
                                                                                       Glow="{Binding Brilho}" Interactive="{Binding EfeitoMouse}" />
                                                        </Button>
                                                        <Button Content="×" Margin="4,0,0,0" Width="28" Style="{StaticResource BotaoSecundario}"
                                                                Command="{Binding ElementName=Raiz, Path=DataContext.RemoverBadgeCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border CornerRadius="10" Padding="12,9" Margin="0,4,0,9"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Pré-visualização ao vivo" Style="{StaticResource RotuloCampo}" />
                                                <controls:InteractiveBadge Text="{Binding NovoBadgeTexto}" Color="{Binding NovoBadgeCor}"
                                                                           Icon="{Binding NovoBadgeIcone}" BadgeStyle="{Binding NovoBadgeEstilo}"
                                                                           CustomIconBase64="{Binding NovoBadgeIconePersonalizadoBase64}"
                                                                           Glow="{Binding NovoBadgeBrilho}" Interactive="{Binding NovoBadgeEfeitoMouse}"
                                                                           HorizontalAlignment="Left" Margin="0,2,0,2" />
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel>
                                            <TextBox Width="130" MaxLength="28" Margin="0,0,7,6" ToolTip="Texto da badge"
                                                     Text="{Binding NovoBadgeTexto, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Width="94" MaxLength="7" Margin="0,0,7,6" ToolTip="Cor hexadecimal"
                                                     Text="{Binding NovoBadgeCor, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox Width="125" Margin="0,0,7,6" ItemsSource="{Binding ElementName=Raiz, Path=DataContext.EstilosBadge}"
                                                      SelectedItem="{Binding NovoBadgeEstilo}" />
                                            <ComboBox Width="115" Margin="0,0,7,6" ItemsSource="{Binding ElementName=Raiz, Path=DataContext.IconesBadge}"
                                                      SelectedItem="{Binding NovoBadgeIcone}" />
                                            <Button Content="Ícone próprio" Margin="0,0,7,6" Style="{StaticResource BotaoSecundario}"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.CarregarIconeBadgeCommand}" CommandParameter="{Binding}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,1,0,6">
                                            <CheckBox Content="Brilho" IsChecked="{Binding NovoBadgeBrilho}" Margin="0,0,18,0" />
                                            <CheckBox Content="Efeito ao passar o mouse" IsChecked="{Binding NovoBadgeEfeitoMouse}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <Button Style="{StaticResource BotaoPrimario}" Content="{Binding AcaoBadgeTexto}" Margin="0,0,8,0"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.AdicionarBadgeCommand}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotaoSecundario}" Content="Nova badge" Margin="0,0,8,0"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.NovaBadgeCommand}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotaoSecundario}" Content="Aplicar mudanças"
                                                    Command="{Binding ElementName=Raiz, Path=DataContext.SalvarPerfilCommand}" CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusComputadorToBrushConverter}}" />
                                        <TextBlock Style="{StaticResource Subtitulo}" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <Run Text="{Binding Status, Converter={StaticResource StatusComputadorToTextoConverter}, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text="{Binding EnderecoIp, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StatusVersaoReceptor}" />
                                                    <Setter Property="Foreground" Value="#A15C00" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TemPainel}" Value="True">
                                                            <Setter Property="Text" Value="{Binding StatusVersaoPainel}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReceptorAtualizado}" Value="True">
                                                            <Setter Property="Foreground" Value="#107C10" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Subtitulo}" FontSize="11" Margin="8,0,0,0">
                                            <Run Text="·  " />
                                            <Run Text="{Binding Monitores.Count, Mode=OneWay}" />
                                            <Run Text=" monitor(es)" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EmEdicao}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Style="{StaticResource BotaoPrimario}" Margin="0,0,8,0"
                                            Content="Atualizar receptor"
                                            Visibility="{Binding PodeAtualizarReceptor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding ElementName=Raiz, Path=DataContext.AtualizarReceptorCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Padding="10,0"
                                            ToolTip="Renomear esta máquina"
                                            Visibility="{Binding PodeEditarPerfil, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding ElementName=Raiz, Path=DataContext.RenomearCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                            Content="{Binding Pareado, Converter={StaticResource PareadoToTextoConverter}}"
                                            Command="{Binding ElementName=Raiz, Path=DataContext.PairearCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource BotaoSecundario}" Padding="10,0" ToolTip="Remover da lista"
                                            Command="{Binding ElementName=Raiz, Path=DataContext.RemoverCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
