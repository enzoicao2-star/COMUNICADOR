<UserControl x:Class="Comunicador.Views.ComputadoresView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comunicador.Controls"
             xmlns:models="clr-namespace:Comunicador.Models">
    <UserControl.Resources>
        <Style x:Key="BadgeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type controls:SpotlightCard}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:SpotlightCard}">
                        <Border x:Name="Shell" CornerRadius="16" BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <Grid>
                                <Border x:Name="PART_Spotlight" CornerRadius="16" Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush RadiusX="0.58" RadiusY="0.72">
                                            <GradientStop Color="#3A6C63FF" Offset="0" />
                                            <GradientStop Color="#006C63FF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter ContentSource="Content" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
      <DockPanel x:Name="ListaComputadores" LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Computadores" Style="{StaticResource TituloSecao}" />
                    <Border Margin="12,5,0,0" Padding="9,4" VerticalAlignment="Top"
                            CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            ToolTip="Computadores visíveis nesta lista">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Total" Margin="7,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Computadores.Count}" Margin="5,0,0,0"
                                       FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Máquinas encontradas na rede ou registradas na nuvem, inclusive quando estão desconectadas." Style="{StaticResource Subtitulo}" />
            </StackPanel>
            <Button Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Command="{Binding AtualizarAgoraCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Procurar agora" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Adicionar manualmente" Style="{StaticResource TituloCard}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Subtitulo}" Margin="0,0,0,12"
                           Text="Se a máquina não aparecer sozinha, digite o IP dela para conectar mesmo assim." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NovoIp, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Text="{Binding NovaPorta, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="4" Style="{StaticResource BotaoPrimario}" Content="Adicionar"
                            Command="{Binding AdicionarManualCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12" CornerRadius="4" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding AvisoTopo, Converter={StaticResource TextoParaVisibilidadeConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding AvisoTopo}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12" CornerRadius="4" Padding="12,8"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StatusMensagem, Converter={StaticResource TextoParaVisibilidadeConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMensagem}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,48,0,0" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Computadores.Count, Mode=OneWay}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                       Foreground="{StaticResource UnknownBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Nenhum computador ainda" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource Subtitulo}" HorizontalAlignment="Center" MaxWidth="380"
                       TextAlignment="Center"
                       Text="Instale o receptor nas outras máquinas — elas aparecem aqui sozinhas assim que conectarem." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Computadores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:SpotlightCard Width="282" MinHeight="172" Padding="14"
                                                Margin="0,0,12,12" ReducedMotion="{Binding ReduzirMovimento}"
                                                MouseDoubleClick="AbrirGerenciamentoComputador_DoubleClick">
                            <controls:SpotlightCard.Style>
                                <Style TargetType="{x:Type controls:SpotlightCard}"
                                       BasedOn="{StaticResource {x:Type controls:SpotlightCard}}">
                                    <Setter Property="GlowColor" Value="#5D8AFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemPainel}" Value="True">
                                            <Setter Property="GlowColor" Value="#8B6CFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StatusComputador.Offline}">
                                            <Setter Property="GlowColor" Value="#7E879A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:SpotlightCard.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" LastChildFill="True" VerticalAlignment="Center">
                                        <Border DockPanel.Dock="Right" CornerRadius="5" Padding="5,2" Margin="5,0,0,0"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding EsteComputador, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Este é o computador onde o Comunicador está aberto">
                                            <TextBlock Text="EU" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="4" Padding="0"
                                                Margin="5,0,0,0" Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding TemPermissoesIndividuais, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Este usuário tem permissões individuais">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding NomeExibicao}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border Grid.Column="1" CornerRadius="9" Padding="7,4"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Margin="7,0,6,0"
                                            VerticalAlignment="Center" ToolTip="Latência individual medida com este computador">
                                        <TextBlock Text="{Binding PingTexto}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Button Grid.Column="2" Width="29" Height="29" Padding="0"
                                            Style="{StaticResource BotaoSecundario}"
                                            ToolTip="Configurações deste computador"
                                            Click="AbrirGerenciamentoComputador_Click">
                                        <TextBlock Text="&#xE10C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Nome}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               MaxWidth="175" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="6"
                                            Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding TemPainel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="PAINEL" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <WrapPanel Grid.Row="2" Margin="0,6,0,4" VerticalAlignment="Top">
                                    <controls:InteractiveBadge Text="OWNER" Color="#F2B84B" Icon="Coroa"
                                                               BadgeStyle="Holográfica" Glow="True" Interactive="True"
                                                               Margin="0,0,6,4"
                                                               Visibility="{Binding ExibirOwnerPadrao, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Badges}" Width="250">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:InteractiveBadge Text="{Binding Texto}" Color="{Binding Cor}"
                                                                           Icon="{Binding Icone}" BadgeStyle="{Binding Estilo}"
                                                                           CustomIconBase64="{Binding IconePersonalizadoBase64}"
                                                                           Glow="{Binding Brilho}" Interactive="{Binding EfeitoMouse}"
                                                                           FloatAnimation="{Binding AnimacaoFlutuante}"
                                                                           Margin="0,0,6,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <Border Grid.Row="3" Margin="0,1,0,0" Padding="0,6,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusComputadorToBrushConverter}}" />
                                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Status, Converter={StaticResource StatusComputadorToTextoConverter}}" />
                                        <TextBlock Margin="6,0,0,0" FontSize="11" Text="·"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Margin="6,0,0,0" MaxWidth="164" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding EnderecoIpExibicao}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="4" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding StatusVersoes}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusVersoes}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding StatusRecebimentoMidias}" FontSize="10"
                                               Foreground="#A15C00" Margin="0,2,0,0"
                                               Visibility="{Binding MidiasBloqueadas, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </controls:SpotlightCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
</UserControl>
