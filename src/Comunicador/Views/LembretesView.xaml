<UserControl x:Class="Comunicador.Views.LembretesView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="Lembretes" Style="{StaticResource TituloSecao}" Margin="0" />
                <TextBlock Text="Agende um aviso para ser enviado automaticamente." Style="{StaticResource Subtitulo}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Título" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,14" />

                <TextBlock Text="Mensagem" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,14" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Data" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DataSelecionada}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hora (HH:mm)" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding HoraTexto, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Permitir resposta do computador" IsChecked="{Binding PermitirResposta}" Margin="0,0,0,14" />

                <TextBlock Text="Enviar para" Style="{StaticResource Subtitulo}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Destinatarios}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Computador.Nome}" IsChecked="{Binding Selecionado}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BotaoPrimario}" Content="Criar lembrete" Command="{Binding CriarCommand}" />
                    <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Agendados" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lembretes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource Subtitulo}"
                                                   TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <TextBlock Style="{StaticResource Subtitulo}">
                                            <Run Text="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}" />
                                            <Run Text="  •  " />
                                            <Run Text="{Binding Enviado, Mode=OneWay, StringFormat={}{0}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" Content="Remover"
                                            VerticalAlignment="Top"
                                            Command="{Binding ElementName=Raiz, Path=DataContext.RemoverCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
