<UserControl x:Class="Comunicador.Views.LembretesView"
             x:Name="Raiz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <Style x:Key="CalendarDayModern" TargetType="{x:Type primitives:CalendarDayButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
                        <Border x:Name="DaySurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.35" /></Trigger>
                            <Trigger Property="IsToday" Value="True"><Setter TargetName="DaySurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DaySurface" Property="Background" Value="{DynamicResource SidebarHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.28" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarModern" TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayModern}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Container">
      <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Lembretes" Style="{StaticResource TituloSecao}" />
            <TextBlock Text="Agende um aviso para ser enviado automaticamente na hora certa." Style="{StaticResource Subtitulo}" />
        </StackPanel>

        <Grid x:Name="FormularioLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ResumoNovoLembrete" Grid.Column="0" Style="{StaticResource CardBorder}"
                    Padding="16" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Novo lembrete" Style="{StaticResource TituloCard}" />
                            <TextBlock Text="Resumo do agendamento" Style="{StaticResource Subtitulo}" />
                        </StackPanel>
                        <Button Content="Alterar configurações" Style="{StaticResource BotaoPrimario}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="AbrirEditorLembrete_Click" />
                    </Grid>
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="11,9" CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Titulo, TargetNullValue=Novo lembrete}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Mensagem, TargetNullValue=Sem mensagem}"
                                       Style="{StaticResource Subtitulo}" TextWrapping="Wrap" MaxHeight="42" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                        <TextBlock Text="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy 'às' HH:mm}, Mode=OneWay}"
                                   Style="{StaticResource Subtitulo}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TextoDestinatariosSelecionados}"
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="A pessoa poderá responder" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding PermitirResposta}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Resposta desativada" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitulo}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding PermitirResposta}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="FormularioLembrete" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorder}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Novo lembrete" Style="{StaticResource TituloCard}" Margin="0,0,0,14" />

                        <TextBlock Text="Título" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,16" />

                        <TextBlock Text="Mensagem" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000"
                                 Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="11,8" Margin="0,0,0,16" />

                        <TextBlock Text="Data (DD/MM/AAAA)" Style="{StaticResource RotuloCampo}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DataTexto, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
                            <Button x:Name="OpenCalendarButton" Grid.Column="2" Content="&#xE787;"
                                    FontFamily="Segoe MDL2 Assets" Style="{StaticResource BotaoSecundario}"
                                    Padding="0" ToolTipService.IsEnabled="False" Click="OpenCalendar_Click"
                                    AutomationProperties.Name="Escolher data no calendário" />
                            <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=OpenCalendarButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="10">
                                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.24" /></Border.Effect>
                                    <Calendar x:Name="DateCalendar" Style="{StaticResource CalendarModern}"
                                              Language="pt-BR" FirstDayOfWeek="Sunday"
                                              SelectedDatesChanged="CalendarDate_SelectedDatesChanged" />
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Text="Hora (HH:mm)" Style="{StaticResource RotuloCampo}" />
                        <TextBox Text="{Binding HoraTexto, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="5" Margin="0,0,0,16" ToolTip="Digite a hora no formato 09:30" />

                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                            <CheckBox IsChecked="{Binding PermitirResposta}" Margin="0">
                                <TextBlock Text="Permitir que a pessoa responda" />
                            </CheckBox>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Enviar para" Style="{StaticResource RotuloCampo}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TextoDestinatariosSelecionados}" Style="{StaticResource Subtitulo}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="Selecionar computadores"
                                            Style="{StaticResource BotaoSecundario}" Click="OpenRecipients_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BotaoPrimario}" Content="Criar lembrete" Command="{Binding CriarCommand}" />
                            <TextBlock Text="{Binding StatusOperacao}" Style="{StaticResource Subtitulo}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Agendados" Style="{StaticResource TituloCard}" Margin="0,0,0,12" />

                <StackPanel DockPanel.Dock="Top" Margin="0,40,0,0" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Lembretes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{StaticResource UnknownBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum lembrete agendado" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lembretes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardListaBorder}" Margin="0,0,0,8" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Margin="0,2,14,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource Subtitulo}" Margin="0,2,0,6" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource SeloBorder}" Padding="8,2"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}" />
                                                </Border>
                                                <Border Style="{StaticResource SeloBorder}" Padding="8,2" Margin="6,0,0,0"
                                                        Background="{DynamicResource SidebarHoverBrush}"
                                                        Visibility="{Binding Enviado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Já enviado" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Padding="10,0"
                                                VerticalAlignment="Top" ToolTip="Remover lembrete"
                                                Command="{Binding ElementName=Raiz, Path=DataContext.RemoverCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
      </DockPanel>

      <Grid x:Name="RecipientsOverlay" Panel.ZIndex="20" Visibility="Collapsed"
            Background="Transparent" MouseDown="Overlay_MouseDown">
        <Border Width="620" MinHeight="350" MaxHeight="640" Margin="20" Padding="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Margin="0,0,48,12">
                        <TextBlock Text="Selecionar computadores" Style="{StaticResource TituloCard}" FontSize="19" />
                        <TextBlock Text="Escolha um ou mais computadores para receber este lembrete."
                                   Style="{StaticResource Subtitulo}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32"
                            Padding="0" Content="×" FontFamily="Segoe UI" Style="{StaticResource BotaoSecundario}"
                            ToolTip="Fechar" Click="CloseRecipients_Click" />
                </Grid>
                <TextBox x:Name="FiltroDestinatarios" Grid.Row="1" Margin="0,0,0,9"
                         ToolTip="Filtrar por apelido, nome do computador ou endereço IP"
                         TextChanged="FiltroDestinatarios_TextChanged" />
                <ListBox x:Name="ListaDestinatarios" Grid.Row="2" MinHeight="160" MaxHeight="440"
                         Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}"
                                      Content="{Binding Computador.NomeExibicao}" Margin="8,5" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Selecionar todos" Style="{StaticResource BotaoSecundario}"
                            Click="SelectAllRecipients_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Limpar seleção" Style="{StaticResource BotaoSecundario}"
                            Click="ClearRecipients_Click" />
                    <TextBlock Grid.Column="2" Text="{Binding TextoDestinatariosSelecionados}"
                               Style="{StaticResource Subtitulo}" VerticalAlignment="Center" Margin="12,0" />
                    <Button Grid.Column="3" Content="Concluído" Style="{StaticResource BotaoPrimario}"
                            Click="CloseRecipients_Click" />
                </Grid>
            </Grid>
        </Border>
      </Grid>

      <Grid x:Name="EditorLembreteOverlay" Panel.ZIndex="19" Visibility="Collapsed"
            Background="Transparent" MouseDown="EditorLembreteOverlay_MouseDown">
        <Border MaxWidth="760" MaxHeight="780" Margin="24" Padding="16"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Configurar lembrete" Style="{StaticResource TituloCard}" FontSize="19" />
                        <TextBlock Text="Escolha o conteúdo, horário, resposta e computadores de destino."
                                   Style="{StaticResource Subtitulo}" />
                    </StackPanel>
                    <Button Content="×" FontFamily="Segoe UI" Width="34" Height="32" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource BotaoSecundario}" ToolTip="Fechar"
                            Click="FecharEditorLembrete_Click" />
                </Grid>
                <ContentControl x:Name="EditorLembreteConteudo" Grid.Row="1" />
            </Grid>
        </Border>
      </Grid>
    </Grid>
</UserControl>
