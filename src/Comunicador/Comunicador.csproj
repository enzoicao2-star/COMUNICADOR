<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Comunicador</AssemblyName>
    <RootNamespace>Comunicador</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>2.5.11</Version>
    <AssemblyVersion>2.5.11.0</AssemblyVersion>
    <FileVersion>2.5.11.0</FileVersion>
    <Product>Comunicador</Product>
    <ApplicationIcon>Assets\Comunicador.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Comunicador.ico" />
    <EmbeddedResource Include="..\..\receiver\receptor.py"
                      Link="ReceiverResources\receptor.py"
                      LogicalName="Comunicador.Receiver.receptor.py" />
    <EmbeddedResource Include="..\..\receiver\protocolo.py"
                      Link="ReceiverResources\protocolo.py"
                      LogicalName="Comunicador.Receiver.protocolo.py" />
    <EmbeddedResource Include="..\..\receiver\carousel-worker.ps1"
                      Link="ReceiverResources\carousel-worker.ps1"
                      LogicalName="Comunicador.Receiver.carousel-worker.ps1" />
    <EmbeddedResource Include="..\..\receiver\audio-control.ps1"
                      Link="ReceiverResources\audio-control.ps1"
                      LogicalName="Comunicador.Receiver.audio-control.ps1" />
  </ItemGroup>

</Project>
