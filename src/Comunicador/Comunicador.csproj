<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName Condition="'$(TestBuild)' != 'true'">Comunicador</AssemblyName>
    <AssemblyName Condition="'$(TestBuild)' == 'true'">Comunicador-Teste</AssemblyName>
    <RootNamespace>Comunicador</RootNamespace>
    <Platforms>x64</Platforms>
    <Version Condition="'$(TestBuild)' != 'true'">2.5.37</Version>
    <AssemblyVersion Condition="'$(TestBuild)' != 'true'">2.5.37.0</AssemblyVersion>
    <FileVersion Condition="'$(TestBuild)' != 'true'">2.5.37.0</FileVersion>
    <Version Condition="'$(TestBuild)' == 'true'">2.5.27.2</Version>
    <AssemblyVersion Condition="'$(TestBuild)' == 'true'">2.5.27.2</AssemblyVersion>
    <FileVersion Condition="'$(TestBuild)' == 'true'">2.5.27.2</FileVersion>
    <DefineConstants Condition="'$(TestBuild)' == 'true'">$(DefineConstants);TEST_BUILD</DefineConstants>
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(Configuration)' == 'Release'">true</IncludeNativeLibrariesForSelfExtract>
    <Product>Comunicador</Product>
    <ApplicationIcon>Assets\Comunicador.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Comunicador.ico" />
    <Resource Include="Assets\Comunicador-Splash.png" />
    <EmbeddedResource Include="..\..\receiver\receptor.py"
                      Link="ReceiverResources\receptor.py"
                      LogicalName="Comunicador.Receiver.receptor.py"
                      Condition="'$(TestBuild)' != 'true'" />
    <EmbeddedResource Include="..\..\release\teste\receiver\receptor.py"
                      LogicalName="Comunicador.Receiver.receptor.py"
                      Condition="'$(TestBuild)' == 'true'" />
    <EmbeddedResource Include="..\..\release\panel-changelog.json"
                      LogicalName="Comunicador.Release.panel-changelog.json" />
    <EmbeddedResource Include="..\..\receiver\protocolo.py"
                      Link="ReceiverResources\protocolo.py"
                      LogicalName="Comunicador.Receiver.protocolo.py"
                      Condition="'$(TestBuild)' != 'true'" />
    <EmbeddedResource Include="..\..\release\teste\receiver\protocolo.py"
                      LogicalName="Comunicador.Receiver.protocolo.py"
                      Condition="'$(TestBuild)' == 'true'" />
    <EmbeddedResource Include="..\..\receiver\carousel-worker.ps1"
                      Link="ReceiverResources\carousel-worker.ps1"
                      LogicalName="Comunicador.Receiver.carousel-worker.ps1" />
    <EmbeddedResource Include="..\..\receiver\audio-control.ps1"
                      Link="ReceiverResources\audio-control.ps1"
                      LogicalName="Comunicador.Receiver.audio-control.ps1" />
  </ItemGroup>

</Project>
