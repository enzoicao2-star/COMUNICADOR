<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Comunicador</AssemblyName>
    <RootNamespace>Comunicador</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <Product>Comunicador</Product>
    <ApplicationIcon>Assets\Comunicador.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Comunicador.ico" />
    <EmbeddedResource Include="..\..\receiver\receptor.py"
                      Link="ReceiverResources\receptor.py"
                      LogicalName="Comunicador.Receiver.receptor.py" />
    <EmbeddedResource Include="..\..\receiver\protocolo.py"
                      Link="ReceiverResources\protocolo.py"
                      LogicalName="Comunicador.Receiver.protocolo.py" />
  </ItemGroup>

</Project>
