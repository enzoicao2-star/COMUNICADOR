<Window x:Class="Comunicador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Comunicador.Controls"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Comunicador" Height="820" Width="1260" MinHeight="600" MinWidth="760"
        Loaded="OnWindowLoaded" StateChanged="OnWindowStateChanged"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}" Icon="Assets/Comunicador.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="7"
                            CornerRadius="13" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PingOfflineBrush" Color="#171717" />
        <SolidColorBrush x:Key="PingExcellentBrush" Color="#19A15F" />
        <SolidColorBrush x:Key="PingMediumBrush" Color="#C98700" />
        <SolidColorBrush x:Key="PingHighBrush" Color="#E34747" />

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Opacity" Value="0.66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#B50D1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type controls:HoverNavButton}">
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:HoverNavButton}">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverPill" Height="34" Margin="10,0" CornerRadius="17"
                                    Background="{DynamicResource SidebarHoverBrush}" Opacity="0"
                                    VerticalAlignment="Bottom" />
                            <TextBlock x:Name="IconText" Text="{TemplateBinding Icon}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,41,0,0">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                                        <RotateTransform x:Name="IconRotate" Angle="0" />
                                        <TranslateTransform x:Name="IconMove" Y="0" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Opacity="0"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4,43,4,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverPill" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="IconText" Property="Foreground" Value="White" />
                                <Setter TargetName="HoverPill" Property="Opacity" Value="0" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconMove" Storyboard.TargetProperty="Y"
                                                             To="-23" Duration="0:0:0.34">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" From="0.84" To="1" Duration="0:0:0.32" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" From="0.84" To="1" Duration="0:0:0.32" />
                                            <DoubleAnimation Storyboard.TargetName="IconRotate" Storyboard.TargetProperty="Angle" From="-8" To="0" Duration="0:0:0.34" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconMove" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.34">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsLabelVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="0.72" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="0.72" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="LabelText" Storyboard.TargetProperty="Opacity" To="1"
                                                             BeginTime="0:0:0.05" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="LabelText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="ativo" />
                                    <Condition Property="IsLabelVisible" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="LabelText" Property="Margin" Value="4,17,4,0" />
                                <Setter TargetName="LabelText" Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource BackgroundBrush}" CornerRadius="13">
        <Grid>
            <controls:AnimatedBackground Mode="{Binding Configuracoes.FundoPainel}"
                                         Intensity="100"
                                         ReduceMotion="{Binding Configuracoes.ReduzirMovimento}" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="142" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="66" VerticalAlignment="Top" Panel.ZIndex="5">
                    <Border Margin="0,39,13,0" Padding="11,5" HorizontalAlignment="Right"
                            VerticalAlignment="Top" CornerRadius="15" Background="#F7F8FA">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource PingOfflineBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PingNivel}" Value="excelente"><Setter Property="Fill" Value="{StaticResource PingExcellentBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding PingNivel}" Value="medio"><Setter Property="Fill" Value="{StaticResource PingMediumBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding PingNivel}" Value="alto"><Setter Property="Fill" Value="{StaticResource PingHighBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PingTexto}" FontSize="11" FontWeight="SemiBold"
                                       Margin="7,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PingOfflineBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PingNivel}" Value="excelente"><Setter Property="Foreground" Value="{StaticResource PingExcellentBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding PingNivel}" Value="medio"><Setter Property="Foreground" Value="{StaticResource PingMediumBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding PingNivel}" Value="alto"><Setter Property="Foreground" Value="{StaticResource PingHighBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,3,10,0" VerticalAlignment="Top"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimizeClick"
                                automation:AutomationProperties.Name="Minimizar" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;"
                                Click="OnMaximizeRestoreClick" automation:AutomationProperties.Name="Maximizar ou restaurar" />
                        <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnCloseClick"
                                automation:AutomationProperties.Name="Fechar" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="TopNavigation" Grid.Row="0" MaxWidth="744" Margin="24,0" Height="76"
                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Panel.ZIndex="3"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:AnimatedNavBackground Margin="12,0" ItemCount="6"
                                                    ActiveIndex="{Binding IndiceSecaoAtiva}"
                                                    ReduceMotion="{Binding Configuracoes.ReduzirMovimento}">
                        <controls:AnimatedNavBackground.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.25" Color="#000000" />
                        </controls:AnimatedNavBackground.Effect>
                    </controls:AnimatedNavBackground>
                    <UniformGrid Columns="6" Margin="12,0">
                        <controls:HoverNavButton Icon="&#xE977;" Label="Computadores" Command="{Binding NavegarCommand}"
                            automation:AutomationProperties.Name="Computadores" CommandParameter="computadores"
                            Tag="{Binding SecaoAtiva, ConverterParameter=computadores, Converter={StaticResource SecaoAtivaConverter}}" />
                        <controls:HoverNavButton Icon="&#xE715;" Label="Mensagens" Command="{Binding NavegarCommand}"
                            automation:AutomationProperties.Name="Mensagens" CommandParameter="mensagens"
                            Tag="{Binding SecaoAtiva, ConverterParameter=mensagens, Converter={StaticResource SecaoAtivaConverter}}" />
                        <controls:HoverNavButton Icon="&#xE823;" Label="Lembretes" Command="{Binding NavegarCommand}"
                            automation:AutomationProperties.Name="Lembretes" CommandParameter="lembretes"
                            Tag="{Binding SecaoAtiva, ConverterParameter=lembretes, Converter={StaticResource SecaoAtivaConverter}}" />
                        <controls:HoverNavButton Icon="&#xE81C;" Label="Histórico" Command="{Binding NavegarCommand}"
                            automation:AutomationProperties.Name="Histórico" CommandParameter="historico"
                            Tag="{Binding SecaoAtiva, ConverterParameter=historico, Converter={StaticResource SecaoAtivaConverter}}" />
                        <controls:HoverNavButton Icon="&#xE9D9;" Label="Logs" Command="{Binding NavegarCommand}"
                            automation:AutomationProperties.Name="Logs" CommandParameter="logs"
                            Tag="{Binding SecaoAtiva, ConverterParameter=logs, Converter={StaticResource SecaoAtivaConverter}}" />
                        <controls:HoverNavButton Icon="&#xE713;" Label="Configurações" Command="{Binding NavegarCommand}"
                            automation:AutomationProperties.Name="Configurações" CommandParameter="configuracoes"
                            Tag="{Binding SecaoAtiva, ConverterParameter=configuracoes, Converter={StaticResource SecaoAtivaConverter}}" />
                    </UniformGrid>
                </Grid>

                <Border Grid.Row="1" Margin="28,10,28,24" Background="Transparent">
                    <ContentControl x:Name="SectionContent">
                        <ContentControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SectionScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="SectionTransform" />
                            </TransformGroup>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
