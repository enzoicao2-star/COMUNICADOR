<Window x:Class="Comunicador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comunicador" Height="760" Width="1180" MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Comunicador" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextOnDarkBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Painel de avisos da rede local" FontSize="12"
                               Foreground="#8A8A8A" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Foreground explicito: o estilo implicito de TextBlock pinta o texto
                     de escuro e, sobre a barra escura, a navegacao some. -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="computadores"
                            Tag="{Binding SecaoAtiva, ConverterParameter=computadores, Converter={StaticResource SecaoAtivaConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24"
                                       Foreground="{StaticResource TextOnDarkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Computadores" Foreground="{StaticResource TextOnDarkBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="mensagens"
                            Tag="{Binding SecaoAtiva, ConverterParameter=mensagens, Converter={StaticResource SecaoAtivaConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24"
                                       Foreground="{StaticResource TextOnDarkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Mensagens" Foreground="{StaticResource TextOnDarkBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="lembretes"
                            Tag="{Binding SecaoAtiva, ConverterParameter=lembretes, Converter={StaticResource SecaoAtivaConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24"
                                       Foreground="{StaticResource TextOnDarkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Lembretes" Foreground="{StaticResource TextOnDarkBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="historico"
                            Tag="{Binding SecaoAtiva, ConverterParameter=historico, Converter={StaticResource SecaoAtivaConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24"
                                       Foreground="{StaticResource TextOnDarkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Histórico" Foreground="{StaticResource TextOnDarkBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="configuracoes"
                            Tag="{Binding SecaoAtiva, ConverterParameter=configuracoes, Converter={StaticResource SecaoAtivaConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24"
                                       Foreground="{StaticResource TextOnDarkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Configurações" Foreground="{StaticResource TextOnDarkBrush}"
                                       FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
                    <Border Height="1" Background="#3D3D3D" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#6BB700" VerticalAlignment="Center" />
                        <TextBlock Text="Somente rede local" FontSize="11" Foreground="#8A8A8A"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" Padding="32,28">
            <ContentControl Content="{Binding SecaoAtual}" />
        </Border>
    </Grid>
</Window>
