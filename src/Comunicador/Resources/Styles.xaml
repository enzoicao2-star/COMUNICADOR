<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Comunicador.Controls">

    <!-- Paleta e metricas seguindo o Fluent do Windows 11: cantos arredondados,
         bordas discretas, acento azul e camadas de fundo (janela / card). -->

    <!-- O padrão é escuro, igual ao AppSettings inicial. Isso evita um quadro
         claro durante a primeira aplicação do tema. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#080B11" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121923" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#192231" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#B3121923" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#CC192231" />
    <SolidColorBrush x:Key="CardGlassBorderBrush" Color="#9952637C" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#121923" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#273347" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#33435C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#659DFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3377EA" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8C3D2" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="TextOnDarkDimBrush" Color="#C2CCDA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#344156" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#52637C" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#6A7A91" />
    <SolidColorBrush x:Key="OnlineBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="NavSurfaceBrush" Color="#171D29" />
    <SolidColorBrush x:Key="BackgroundLineBrush" Color="#93B8EA" />

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <DropShadowEffect x:Key="GlassCardShadow" Color="#000000" BlurRadius="18"
                      ShadowDepth="2" Direction="270" Opacity="0.26" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Tipografia Fluent -->
    <Style x:Key="TituloSecao" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RotuloCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="TituloCard" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect" Value="{StaticResource GlassCardShadow}" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.72" To="1"
                                         Duration="0:0:0.32" FillBehavior="Stop" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Item de lista com realce ao passar o mouse, como nas listas do Windows 11 -->
    <Style x:Key="CardListaBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="6,2">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <!-- barra de selecao a esquerda, igual a NavigationView do WinUI -->
                        <Border x:Name="Indicador" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="1,0,0,0" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="ativo">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                            <Setter TargetName="Indicador" Property="Background" Value="#4CC2FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="ButtonScale" /></Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.16" /><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" /><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.08" />
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.08" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#CCCCCC" />
                            <Setter Property="Foreground" Value="#8A8A8A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="ButtonScale" /></Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.16" /><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" /><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.08" />
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.08" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de texto Fluent: borda fina, cantos 4px e sublinhado de acento no foco -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" />
                        <Border x:Name="Foco" CornerRadius="0,0,4,4" Height="2" VerticalAlignment="Bottom"
                                Background="Transparent" Margin="1,0,1,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1" /></Border.RenderTransform>
                        </Border>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Foco"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.24">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Foco"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0" Duration="0:0:0.18" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Caixa" Width="20" Height="20" CornerRadius="4"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="CheckBoxScale" /></Border.RenderTransform>
                            <Path x:Name="Check" Data="M 0,4 L 3.5,7.5 L 9,1" Stroke="White" StrokeThickness="1.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                  RenderTransformOrigin="0.5,0.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round">
                                <Path.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="0.55" ScaleY="0.55" /></Path.RenderTransform>
                            </Path>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.20" /><DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.20" /><DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="0.55" Duration="0:0:0.14" /><DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="0.55" Duration="0:0:0.14" /><DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Caixa" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="Caixa" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Caixa" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetName="Caixa" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Outer" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                            CornerRadius="7">
                                        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform x:Name="ArrowRotate" Angle="0" /></Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.20"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="11,0,38,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Margin="0,4,0,0" Padding="5" CornerRadius="8"
                                    Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <Grid>
                            <ContentPresenter Margin="0,0,24,0" />
                            <Path x:Name="SelectedCheck" Data="M 0,4 L 3,7 L 8,0"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Width="10" Height="9" Visibility="Collapsed" Opacity="0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6" /></Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="3" Duration="0:0:0.14" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.18" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                            <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectedCheck" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetName="SelectedCheck"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.28" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SelectedCheck"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.28" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="52" Margin="7,0">
                        <Track x:Name="PART_Track" Height="20" Margin="0,31,0,0" VerticalAlignment="Top"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" Background="{DynamicResource SidebarHoverBrush}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <controls:NumberFlowThumb Width="20" Height="20"
                                    Value="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                                    Suffix="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}">
                                    <controls:NumberFlowThumb.Template>
                                        <ControlTemplate TargetType="controls:NumberFlowThumb">
                                            <Canvas Width="20" Height="20" ClipToBounds="False">
                                                <Border x:Name="ThumbFace" Width="20" Height="20" CornerRadius="10" Background="White"
                                                        BorderBrush="#22000000" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.24" />
                                                    </Border.Effect>
                                                </Border>
                                                <Border x:Name="ValueBubble" Width="64" Height="27" Canvas.Left="-22" Canvas.Top="-31"
                                                        CornerRadius="7" Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform />
                                                            <TranslateTransform />
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                    <Grid ClipToBounds="True">
                                                        <TextBlock x:Name="PART_PreviousValue" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                                                        </TextBlock>
                                                        <TextBlock x:Name="PART_CurrentValue" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </Canvas>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.16" Duration="0:0:0.16" />
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.16" Duration="0:0:0.16" />
                                                        <DoubleAnimation Storyboard.TargetName="ValueBubble"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         To="-3" Duration="0:0:0.18" />
                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="ValueBubble"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         To="0" Duration="0:0:0.2" />
                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.3" Duration="0:0:0.11" />
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.3" Duration="0:0:0.11" />
                                                        <DoubleAnimation Storyboard.TargetName="ValueBubble"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                         To="1.08" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="ValueBubble"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                         To="1.08" Duration="0:0:0.15" />
                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.16" Duration="0:0:0.18" />
                                                        <DoubleAnimation Storyboard.TargetName="ThumbFace"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.16" Duration="0:0:0.18" />
                                                        <DoubleAnimation Storyboard.TargetName="ValueBubble"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="0:0:0.18" />
                                                        <DoubleAnimation Storyboard.TargetName="ValueBubble"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                         To="1" Duration="0:0:0.18" />
                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </controls:NumberFlowThumb.Template>
                                </controls:NumberFlowThumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="4" Duration="0:0:0.16" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ItemBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.2" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de rolagem fina, no estilo do Windows 11 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#8A8A8A" CornerRadius="3" Width="6"
                                                    HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selo de status arredondado -->
    <Style x:Key="SeloBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

</ResourceDictionary>
